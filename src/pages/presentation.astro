---
import Base from '../layouts/Base.astro';
import { presentation, reels, posters, situations, presse } from '../data/presentation';
import ReelPhone from '../components/ReelPhone.astro';
import PresIntro from '../components/PresIntro.astro';
import PresSlides from '../components/PresSlides.astro';
import { url } from '../lib/url';
import LightscapeGallery from '../components/LightscapeGallery.astro';
---

<Base
  title="Présentation du projet · Vitra Lightscape"
  description="Page interne : les visuels de la campagne Vitra Lightscape reliés par un chemin de lumière."
  home={false}
>
  <meta name="robots" content="noindex, nofollow" slot="head" />
  <div class="trail" data-trail>
  <svg class="trail__svg" aria-hidden="true" focusable="false">
    <path class="trail__line" data-trail-base />
    <path class="trail__line trail__line--lit" data-trail-lit />
    <g data-trail-nodes></g>
  </svg>
  <PresIntro />
  <PresSlides />

  <section class="pres" data-theme="night" aria-labelledby="pres-title">
    <div class="container">
      <header class="pres__intro">
        <p class="eyebrow">{presentation.label}</p>
        <h1 class="pres__title" id="pres-title">{presentation.title}</h1>
        <p class="pres__lead">{presentation.text}</p>
      </header>

      <ol class="pres__path" data-pres>
        {
          presentation.stations.map((s, i) => (
            <li class={`station station--${i % 2 ? 'right' : 'left'}${s.reels || s.posters || s.cards ? ' station--wide' : ''}`} data-station>
              <span class="station__node" data-node aria-hidden="true"></span>
              {s.cards ? (
                <div class="cards-block">
                  <LightscapeGallery />
                </div>
              ) : s.posters ? (
                <div class="posters-block">
                  <div class="posters-row">
                    {posters.map((p, n) => (
                      <figure class="posters-row__item">
                        <button type="button" class="poster" data-poster={n} aria-label={`${p.title} : afficher l’affiche en plein écran`}>
                          <img src={url(p.src)} alt={p.alt} width="1413" height="2000" loading="lazy" decoding="async" />
                          <span class="poster__zoom" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="18" height="18"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
                          </span>
                        </button>
                        <figcaption><strong>{p.title}</strong><span>{p.sub}</span></figcaption>
                      </figure>
                    ))}
                  </div>

                  <p class="posters-block__label">En situation</p>
                  <div class="posters-row posters-row--situ" style={`--cols:${situations.map((x) => (x.w / x.h).toFixed(3)).join('fr ')}fr`}>
                    {situations.map((p, m) => (
                      <figure class="posters-row__item">
                        <button type="button" class="poster" data-poster={posters.length + m} aria-label={`${p.title} : afficher l’image en plein écran`}>
                          <img src={url(p.src)} alt={p.alt} width={p.w} height={p.h} loading="lazy" decoding="async" />
                          <span class="poster__zoom" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="18" height="18"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
                          </span>
                        </button>
                        <figcaption><strong>{p.title}</strong><span>{p.sub}</span></figcaption>
                      </figure>
                    ))}
                  </div>

                  <p class="posters-block__label">Dans la presse</p>
                  <div class="posters-row posters-row--presse">
                    {presse.map((p, m) => (
                      <figure class="posters-row__item">
                        <button type="button" class="poster" data-poster={posters.length + situations.length + m} aria-label={`${p.title} : afficher la page en plein écran`}>
                          <img src={url(p.src)} alt={p.alt} width={p.w} height={p.h} loading="lazy" decoding="async" />
                          <span class="poster__zoom" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="18" height="18"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
                          </span>
                        </button>
                        <figcaption><strong>{p.title}</strong><span>{p.sub}</span></figcaption>
                      </figure>
                    ))}
                  </div>
                </div>
              ) : s.reels ? (
                <div class="reels-row">
                  {reels.map((r, n) => (
                    <figure class="reels-row__item">
                      <div class="reels-row__open" role="button" tabindex="0" data-open-phone={n} aria-label={`${r.label} : afficher le mockup en plein écran`}>
                      <ReelPhone platform={r.platform} caption={r.video ? r.caption : ['Légende à venir']} tags={r.video ? r.tags : ''} likes={r.video ? r.likes : '—'} comments={r.video ? r.comments : '—'} shares={r.video ? r.shares : '—'}>
                        {r.video ? (
                          <>
                            <video class="reel-video" muted loop playsinline preload="metadata" poster={url(r.poster ?? '')} style={[r.cadrage ? `object-position:${r.cadrage}` : '', r.ajuste ? `object-fit:${r.ajuste}` : ''].filter(Boolean).join(';') || undefined} aria-label={r.label + ' : ' + r.sub}>
                              <source src={url(r.video)} type="video/mp4" />
                            </video>
                            <button type="button" class="reel-play" data-play aria-label="Lancer la lecture">
                              <svg class="reel-play__play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5Z" fill="currentColor" /></svg>
                              <svg class="reel-play__pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7.5 5.5h3.4v13H7.5zM13.1 5.5h3.4v13h-3.4z" fill="currentColor" /></svg>
                            </button>
                            <button type="button" class="reel-sound" data-sound aria-pressed="false" aria-label="Activer le son du teaser">
                              <svg class="reel-sound__off" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.6L12 6v12l-4.4-3.5H4Z" fill="currentColor" /><path d="m16 9.5 5 5m0-5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
                              <svg class="reel-sound__on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.6L12 6v12l-4.4-3.5H4Z" fill="currentColor" /><path d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
                            </button>
                          </>
                        ) : (
                          <div class="phone__ph">
                            <span>{r.label}</span>
                            <small>Vidéo à venir</small>
                          </div>
                        )}
                      </ReelPhone>
                      </div>
                      <figcaption>
                        <strong>{r.label}</strong>
                        <span>{r.sub}</span>
                      </figcaption>
                    </figure>
                  ))}
                </div>
              ) : (
                <figure class="station__frame" style={`--ratio:${s.ratio}`}>
                  {s.image ? (
                    <img src={url(s.image)} alt={s.alt ?? ''} loading="lazy" decoding="async" />
                  ) : (
                    <span class="station__empty">
                      <span>{s.format}</span>
                      <small>Visuel à venir</small>
                    </span>
                  )}
                </figure>
              )}
              <div class="station__text">
                <p class="station__n">{String(i + 1).padStart(2, '0')} · {s.label}</p>
                <h2>{s.title}</h2>
                <p>{s.text}</p>
                {s.link && <a class="station__link" href={url(s.link.href)}>{s.link.label} <span aria-hidden="true">→</span></a>}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
  </div>

  <dialog class="lightbox" data-lightbox aria-label="Affiche en plein écran">
    <img class="lightbox__img" data-lightbox-img alt="" />
    <p class="lightbox__cap" data-lightbox-cap></p>
    <button type="button" class="lightbox__btn lightbox__btn--close" data-lightbox-close aria-label="Fermer">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
    </button>
    <button type="button" class="lightbox__btn lightbox__btn--prev" data-lightbox-prev aria-label="Affiche précédente">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M20 12H5M11 6l-6 6 6 6" stroke="currentColor" stroke-width="1.8" fill="none" /></svg>
    </button>
    <button type="button" class="lightbox__btn lightbox__btn--next" data-lightbox-next aria-label="Affiche suivante">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" fill="none" /></svg>
    </button>
  </dialog>

  <dialog class="lightbox phonebox" data-phonebox aria-label="Mockup en plein écran">
    <div class="phonebox__stage" data-phonebox-stage></div>
    <p class="lightbox__cap" data-phonebox-cap></p>
    <button type="button" class="lightbox__btn lightbox__btn--close" data-phonebox-close aria-label="Fermer">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
    </button>
    <button type="button" class="lightbox__btn lightbox__btn--prev" data-phonebox-prev aria-label="Mockup précédent">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M20 12H5M11 6l-6 6 6 6" stroke="currentColor" stroke-width="1.8" fill="none" /></svg>
    </button>
    <button type="button" class="lightbox__btn lightbox__btn--next" data-phonebox-next aria-label="Mockup suivant">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" fill="none" /></svg>
    </button>
  </dialog>


  <script>
    // affiches : un clic ouvre l'affiche en plein écran (Échap, clic à côté, flèches du clavier)
    const box = document.querySelector<HTMLDialogElement>('[data-lightbox]');
    const triggers = [...document.querySelectorAll<HTMLButtonElement>('[data-poster]')];
    if (box && triggers.length) {
      const img = box.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
      const cap = box.querySelector<HTMLElement>('[data-lightbox-cap]')!;
      let at = 0;
      const show = (n: number) => {
        at = (n + triggers.length) % triggers.length;
        const src = triggers[at].querySelector('img')!;
        img.src = src.currentSrc || src.src;
        img.alt = src.alt;
        cap.textContent = triggers[at].closest('figure')?.querySelector('strong')?.textContent ?? '';
      };
      triggers.forEach((b, n) =>
        b.addEventListener('click', () => {
          show(n);
          box.showModal();
        }),
      );
      box.querySelector('[data-lightbox-close]')!.addEventListener('click', () => box.close());
      box.querySelector('[data-lightbox-prev]')!.addEventListener('click', () => show(at - 1));
      box.querySelector('[data-lightbox-next]')!.addEventListener('click', () => show(at + 1));
      // un clic sur le fond (hors de l'affiche et des boutons) ferme
      box.addEventListener('click', (e) => {
        if (e.target === box) box.close();
      });
      box.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') show(at + 1);
        else if (e.key === 'ArrowLeft') show(at - 1);
      });
    }
  </script>

  <script>
    // mockups : un clic (ou Entrée) affiche le téléphone en grand ; la lecture se lance avec le bouton ▶ (jamais automatiquement)
    const pbox = document.querySelector<HTMLDialogElement>('[data-phonebox]');
    const opens = [...document.querySelectorAll<HTMLElement>('[data-open-phone]')];
    if (pbox && opens.length) {
      const stage = pbox.querySelector<HTMLElement>('[data-phonebox-stage]')!;
      const pcap = pbox.querySelector<HTMLElement>('[data-phonebox-cap]')!;
      let cur = 0;
      // bouton haut-parleur : le son est coupé par défaut (les navigateurs interdisent le son automatique)
      const setSoundButton = (b: Element | null, on: boolean) => {
        if (!b) return;
        b.setAttribute('aria-pressed', String(on));
        b.setAttribute('aria-label', on ? 'Couper le son du teaser' : 'Activer le son du teaser');
      };
      const toggleSound = (b: Element) => {
        const v = b.closest('.phone')?.querySelector('video');
        if (!v) return;
        v.muted = !v.muted;
        setSoundButton(b, !v.muted);
        if (!v.muted && v.paused) v.play().catch(() => undefined);
      };
      // lecture à la demande : le bouton ▶ / ❚❚ au centre de l'écran, et un clic sur la vidéo en plein écran
      const syncPlay = (phone: Element | null) => {
        const v = phone?.querySelector('video');
        if (!phone || !v) return;
        phone.classList.toggle('is-playing', !v.paused);
        phone.querySelector('.reel-play')?.setAttribute('aria-label', v.paused ? 'Lancer la lecture' : 'Mettre en pause');
      };
      const togglePlay = (el: Element) => {
        const phone = el.closest('.phone');
        const v = phone?.querySelector('video');
        if (!v) return;
        if (v.paused) v.play().catch(() => undefined);
        else v.pause();
      };
      const showPhone = (n: number) => {
        cur = (n + opens.length) % opens.length;
        const src = opens[cur].querySelector<HTMLElement>('.phone')!;
        const copy = src.cloneNode(true) as HTMLElement;
        copy.removeAttribute('data-phone');
        stage.replaceChildren(copy);
        const v = copy.querySelector('video');
        if (v) {
          // une copie ne garde pas l'état « muet » : on reprend celui de la vidéo d'origine (le clic sur le téléphone autorise le son)
          v.muted = src.querySelector('video')?.muted ?? true;
          setSoundButton(copy.querySelector('.reel-sound'), !v.muted);
          // on reprend là où la vignette en était : elle se met en pause, la copie joue seulement si la vignette jouait
          const srcV = src.querySelector('video');
          const etaitEnLecture = !!srcV && !srcV.paused;
          if (srcV) {
            v.currentTime = srcV.currentTime;
            srcV.pause();
          }
          v.addEventListener('play', () => syncPlay(copy));
          v.addEventListener('pause', () => syncPlay(copy));
          if (etaitEnLecture) v.play().catch(() => undefined);
          syncPlay(copy);
        }
        pcap.textContent = opens[cur].closest('figure')?.querySelector('figcaption strong')?.textContent ?? '';
      };
      opens.forEach((o, n) => {
        const go = () => {
          showPhone(n);
          pbox.showModal();
        };
        o.addEventListener('click', (e) => {
          const t = e.target as HTMLElement;
          const snd = t.closest('.reel-sound');
          const ply = t.closest('.reel-play');
          if (snd) toggleSound(snd);
          else if (ply) togglePlay(ply);
          else go();
        });
        o.addEventListener('keydown', (e) => {
          if ((e.target as HTMLElement).closest('.reel-sound, .reel-play')) return; // Entrée sur un bouton : c'est lui qui réagit
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            go();
          }
        });
      });
      // on vide la fenêtre à la fermeture (bouton, fond ou Échap) : la vidéo s'arrête
      const shut = () => {
        stage.querySelector('video')?.pause();
        stage.replaceChildren();
      };
      const closeBox = () => {
        shut();
        pbox.close();
      };
      pbox.addEventListener('close', shut);
      pbox.querySelector('[data-phonebox-close]')!.addEventListener('click', closeBox);
      pbox.querySelector('[data-phonebox-prev]')!.addEventListener('click', () => showPhone(cur - 1));
      pbox.querySelector('[data-phonebox-next]')!.addEventListener('click', () => showPhone(cur + 1));
      pbox.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        const snd = t.closest('.reel-sound');
        const ply = t.closest('.reel-play');
        if (snd) toggleSound(snd);
        else if (ply) togglePlay(ply);
        else if (t.closest('.phone video')) togglePlay(t);
        else if (t === pbox || t === stage) closeBox();
      });
      pbox.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') showPhone(cur + 1);
        else if (e.key === 'ArrowLeft') showPhone(cur - 1);
      });
    }
  </script>

  <script>
    // les vidéos des mockups ne démarrent jamais seules : on les lance avec le bouton ▶ ; elles se mettent en pause hors de l'écran
    const videos = [...document.querySelectorAll<HTMLVideoElement>('.reel-video')];
    if (videos.length) {
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (!e.isIntersecting) (e.target as HTMLVideoElement).pause();
          }),
        { threshold: 0.2 },
      );
      videos.forEach((v) => {
        io.observe(v);
        const phone = v.closest('.phone');
        const sync = () => {
          phone?.classList.toggle('is-playing', !v.paused);
          phone?.querySelector('.reel-play')?.setAttribute('aria-label', v.paused ? 'Lancer la lecture' : 'Mettre en pause');
        };
        v.addEventListener('play', sync);
        v.addEventListener('pause', sync);
      });
    }
  </script>

  <script>
    // fil de néon : une ligne droite dans la marge gauche, du tout haut de la page jusqu'à la dernière étape (aucun texte n'est traversé),
    // avec un point à chaque slide et à chaque étape ; elle s'allume au fil du défilement
    const trail = document.querySelector<HTMLElement>('[data-trail]');
    if (trail) {
      const svg = trail.querySelector<SVGSVGElement>('.trail__svg')!;
      const base = trail.querySelector<SVGPathElement>('[data-trail-base]')!;
      const lit = trail.querySelector<SVGPathElement>('[data-trail-lit]')!;
      const g = trail.querySelector<SVGGElement>('[data-trail-nodes]')!;
      const calm = matchMedia('(prefers-reduced-motion: reduce)');
      const NS = 'http://www.w3.org/2000/svg';
      let ys: number[] = [];
      let circles: SVGCircleElement[] = [];
      let height = 0;

      let pathLen = 0;
      const build = () => {
        const box = trail.getBoundingClientRect();
        const cont = trail.querySelector('.container');
        const cr = cont ? cont.getBoundingClientRect() : { left: box.left + 24, right: box.right - 24 };
        const xl = Math.max(8, cr.left - box.left - 20);
        const xr = Math.min(box.width - 8, cr.right - box.left + 20);
        height = box.height;
        svg.setAttribute('width', String(box.width));
        svg.setAttribute('height', String(height));
        svg.setAttribute('viewBox', `0 0 ${box.width} ${height}`);
        // un point par bloc (ouverture, slides, étapes) ; le fil serpente : il longe la marge gauche, puis droite, puis gauche…
        // et change de côté UNIQUEMENT dans l'espace vide au-dessus du bloc suivant : aucun texte n'est traversé
        const blocks = [...trail.querySelectorAll<HTMLElement>('.pi__caption, .sl .eyebrow, .station__n')].map((a) => {
          let holder = (a.closest('.station, .sl, .pi') as HTMLElement) ?? a;
          // la première étape est précédée du titre de la section « La campagne » : le fil change de côté avant ce titre
          if (holder === trail.querySelector('.station')) holder = (trail.querySelector('.pres') as HTMLElement) ?? holder;
          return {
            y: a.getBoundingClientRect().top - box.top + a.getBoundingClientRect().height / 2,
            top: holder.getBoundingClientRect().top - box.top,
          };
        });
        ys = blocks.map((b) => b.y);
        const xs = blocks.map((_, i) => (i % 2 === 0 ? xl : xr));
        let d = `M ${xs[0]} 0 V ${ys[0]}`;
        for (let i = 1; i < blocks.length; i++) {
          // angles droits : on descend dans la marge, on traverse à l'horizontale dans l'espace vide au-dessus du bloc suivant, puis on redescend
          const yb = Math.max(ys[i - 1] + 20, i === 1 ? blocks[i].top + 16 : blocks[i].top - 24); // l'ouverture est suivie d'un espace très court : on traverse dans le haut de la première slide
          d += ` V ${yb} H ${xs[i]} V ${ys[i]}`;
        }
        const fin = (ys[ys.length - 1] ?? height) + 40;
        d += ` V ${fin}`;
        base.setAttribute('d', d);
        lit.setAttribute('d', d);
        pathLen = lit.getTotalLength();
        lit.style.strokeDasharray = String(pathLen);
        g.replaceChildren();
        circles = ys.map((y, i) => {
          const c = document.createElementNS(NS, 'circle');
          c.setAttribute('cx', String(xs[i]));
          c.setAttribute('cy', String(y));
          c.setAttribute('r', '6');
          c.setAttribute('class', 'trail__node');
          g.appendChild(c);
          return c;
        });
        update();
      };

      // longueur du tracé atteinte à la hauteur « y » (le tracé descend toujours)
      const lengthAt = (y: number) => {
        let lo = 0;
        let hi = pathLen;
        for (let k = 0; k < 24; k++) {
          const mid = (lo + hi) / 2;
          if (lit.getPointAtLength(mid).y < y) lo = mid;
          else hi = mid;
        }
        return hi;
      };

      const update = () => {
        if (!pathLen) return;
        const box = trail.getBoundingClientRect();
        const y = calm.matches ? height : Math.min(height, Math.max(0, innerHeight * 0.6 - box.top));
        lit.style.strokeDashoffset = String(calm.matches ? 0 : pathLen - lengthAt(y));
        circles.forEach((c, i) => c.classList.toggle('is-lit', calm.matches || ys[i] <= y + 2));
      };

      let queued = false;
      const tick = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          update();
        });
      };
      addEventListener('scroll', tick, { passive: true });
      addEventListener('resize', build);
      new ResizeObserver(build).observe(trail);
      trail.querySelectorAll('img').forEach((im) => im.addEventListener('load', build));
      addEventListener('load', build);
      build();
    }
  </script>
</Base>
