---
/**
 * Reel teaser Vitra Lightscape : page interne (présentation de l'appel d'offres), pas un contenu visiteur.
 * Vue 1 : vidéo seule, 9:16. Vue 2 : la même vidéo dans une interface de Reel Instagram du compte @vitra.
 * Paramètres d'adresse : ?view=video|mockup · ?clean (aucune interface, scène 1080 x 1920 : sert à l'export) · &t=secondes.
 */
import '../styles/global.css';
import ReelStage from '../components/ReelStage.astro';
import ReelPhone from '../components/ReelPhone.astro';
import { url } from '../lib/url';

const timings = [
  { t: '0:00', text: 'Presque silence, un souffle d’air très léger : fond blanc, logo Vitra noir fixe.' },
  { t: '1:06 – 2:03', text: 'Le trait de néon balaie l’écran : un whoosh grave et doux, avec un bourdonnement électrique fin (le néon), pendant que le fond et le logo s’inversent.' },
  { t: '2:03 – 2:18', text: 'Écran noir, logo blanc : une respiration, presque silence, une nappe grave très basse.' },
  { t: '2:18 – 4:12', text: 'Whoosh brillant synchronisé avec la lumière qui découvre le premier mapping. La barre et « Lightscape » se dessinent derrière elle (3:00 – 3:24) : scintillement fin, et le néon se rallume (petit « clic » électrique).' },
  { t: '4:12', text: 'Petit impact doux : le logo Vitra Lightscape est complet, le premier mapping couvre l’écran.' },
  { t: '5:18 – 7:00', text: 'Deuxième mapping (les ondes) : un whoosh plus aérien, notes très douces, comme des gouttes d’eau dans une salle.' },
  { t: '8:06 – 9:12', text: 'Troisième mapping (les faisceaux) : un whoosh lumineux qui monte, brillance dans les aigus.' },
  { t: '10:24 – 12:06', text: 'Quatrième mapping (la trame de points) : un whoosh rythmé, légers pulsations qui suivent l’ondulation.' },
  { t: '12:18 – 14:00', text: 'Les mappings se retirent, la nappe retombe, le logo reste seul : queue de réverbération et léger fondu vers le noir.' },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Reel teaser · Vitra Lightscape</title>
    <link rel="icon" href={url('vitra-lightscape-logo.svg')} type="image/svg+xml" />
  </head>
  <body class="reel" data-reel>
    <header class="reel__bar">
      <a class="reel__back" href={url('presentation/')}>← Présentation</a>
      <div class="reel__tabs" role="tablist" aria-label="Vue">
        <button type="button" role="tab" data-view="video" aria-selected="true">Vidéo seule</button>
        <button type="button" role="tab" data-view="mockup" aria-selected="false">Mockup Instagram</button>
      </div>
      <div class="reel__tools">
        <button type="button" data-replay>Rejouer</button>
        <label><input type="checkbox" data-loop checked /> Boucle</label>
        <button type="button" data-sound-toggle aria-pressed="false">Son : coupé</button>
        <audio data-audio preload="auto" src={url('reel/teaser-14s-b-lights-musique.mp3')}></audio>
      </div>
    </header>

    <main class="reel__main">
      <section class="reel__view" data-panel="video" aria-label="Vidéo seule">
        <div class="reel__wrap reel__wrap--video" data-wrap><ReelStage /></div>
      </section>

      <section class="reel__view" data-panel="mockup" hidden aria-label="Mockup Instagram Reel">
        <ReelPhone platform="instagram" likes="12,8 K" comments="243" shares="1 456">
          <div class="reel__wrap" data-wrap><ReelStage /></div>
        </ReelPhone>
      </section>

      <aside class="reel__side" data-side>
        <label class="reel__scrub">Instant <output data-time>0:00</output>
          <input type="range" min="0" max="14" step="0.01" value="0" data-scrub aria-label="Instant de la vidéo, en secondes" />
        </label>
        <h2>Repères pour le son (Premiere)</h2>
        <ol class="reel__marks">
          {timings.map((m) => <li><b>{m.t}</b><span>{m.text}</span></li>)}
        </ol>
        <p class="reel__note">Les temps sont en secondes : image, à 30 images par seconde (3:03 = 3,1 s ; 10:00 = 10 s). Durée totale 14 s.</p>
        <p class="reel__links">
          <a href={url('reel/teaser-14s-b-1080x1920.mp4')} download>Vidéo 1080 × 1920 (mp4)</a>
          <a href={url('reel/teaser-14s-b-720x1280.mp4')} download>Vidéo 720 × 1280 (mp4)</a>
          <a href={url('reel/teaser-14s-b-lights-720x1280.mp4')} download>Vidéo 720 × 1280 avec la musique (mp4)</a>
          <a href={url('reel/teaser-14s-b-lights-musique.mp3')} download>Musique seule (mp3, 14 s)</a>
        </p>
      </aside>
    </main>

    <script>
      // ----- chronologie (secondes) -----
      // 0 - 1,2 : « vitra. » noir sur blanc · 1,2 - 2,1 : un trait de néon balaie l'écran, le fond et le logo s'inversent
      // 2,1 - 2,6 : noir · 2,6 - 4,4 : la lumière du mapping 1 dessine la barre et « Lightscape » (le néon s'y rallume)
      // puis trois autres mappings, chacun découvert par une nouvelle lumière, puis le logo reste seul.
      const T = { still: 1.2, off: 2.1, logo: 2.6, fadeStart: 13.7, end: 14 };
      const SCENES = [
        { start: 2.6, dur: 1.8 }, // filaments (bleu / orange)
        { start: 5.6, dur: 1.4 }, // ondes
        { start: 8.2, dur: 1.4 }, // faisceaux
        { start: 10.8, dur: 1.4 }, // trame de points
      ];
      const MAP_OUT = [12.6, 13.4];
      const DURATION = T.end;
      const clamp = (x: number, a = 0, b = 1) => Math.min(b, Math.max(a, x));
      const inOut = (u: number) => (u < 0.5 ? 4 * u * u * u : 1 - Math.pow(-2 * u + 2, 3) / 2);
      const sine = (u: number) => 0.5 - 0.5 * Math.cos(Math.PI * clamp(u));

      const root = document.querySelector<HTMLElement>('[data-reel]')!;
      const params = new URLSearchParams(location.search);
      const clean = params.has('clean');
      root.classList.toggle('is-clean', clean);

      const stages = [...document.querySelectorAll<HTMLElement>('[data-rs]')];
      const wraps = [...document.querySelectorAll<HTMLElement>('[data-wrap]')];

      // le « vitra. » seul est centré (x 520, y 930) ; le logo complet s'en déduit et ne bouge plus
      const locks = stages.map((s) => s.querySelector<HTMLElement>('[data-rs-lock]')!);
      const measure = () => {
        const svg = locks[0].querySelector('svg')!;
        const els = [...svg.querySelectorAll<SVGGraphicsElement>('path:not(.rs-ls), circle')];
        let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
        els.forEach((el) => {
          const b = el.getBBox();
          x0 = Math.min(x0, b.x); y0 = Math.min(y0, b.y); x1 = Math.max(x1, b.x + b.width); y1 = Math.max(y1, b.y + b.height);
        });
        const k = 500 / 346;
        stages.forEach((s) => {
          s.style.setProperty('--lx', `${(520 - ((x0 + x1) / 2) * k).toFixed(1)}px`);
          s.style.setProperty('--ly', `${(930 - ((y0 + y1) / 2) * k).toFixed(1)}px`);
        });
      };

      const front = (t: number, sc: { start: number; dur: number }) => {
        const u = clamp((t - sc.start) / sc.dur);
        return { u, x: -380 + (0.5 - 0.5 * Math.cos(Math.PI * Math.pow(u, 0.92))) * 1880 };
      };

      const render = (t: number) => {
        t = clamp(t, 0, DURATION);
        // 1) « vitra. » noir sur fond blanc ; 2) le néon balaie l'écran : le fond passe au noir, le logo s'inverse (noir → blanc)
        const wp = clamp((t - T.still) / (T.off - T.still));
        const wx = -60 + inOut(wp) * (1080 + 120);
        const nw = wp > 0 && wp < 1 ? Math.pow(Math.sin(Math.PI * Math.min(1, wp * 1.05)), 0.5) : 0;
        const cd = t < T.off + 0.05 ? 1 : 0; // l'inversion cède la place au logo blanc une fois le fond tout noir (invisible)
        // 3) les mappings, un à un ; chacun est découvert par une lumière et remplace le précédent derrière son passage
        const fr = SCENES.map((sc) => front(t, sc));
        let bo = 0;
        let bx = fr[0].x;
        fr.forEach((f, i) => {
          const e = f.u > 0 && f.u < 1 ? Math.pow(Math.sin(Math.PI * f.u), 0.6) : 0;
          if (e > bo) {
            bo = e;
            bx = f.x;
          }
          if (i === fr.length - 1) bx = e > 0 ? bx : fr[i].x;
        });
        const mo = clamp((t - SCENES[0].start) / 0.4) * (1 - sine((t - MAP_OUT[0]) / (MAP_OUT[1] - MAP_OUT[0])));
        // le néon de la barre s'allume quand la lumière la dessine, puis reste en veille
        const draw = clamp((t - 3.0) / 1.0);
        const ng = t < SCENES[0].start ? 0 : 0.25 + 0.75 * Math.sin(Math.PI * clamp((t - 3.0) / 1.5)) ** 2;
        const fd = sine((t - T.fadeStart) / (T.end - T.fadeStart)) * 0.9;
        void draw;
        stages.forEach((s) => {
          const set = (k: string, v: string) => s.style.setProperty(k, v);
          set('--wx', `${wx.toFixed(1)}px`);
          set('--nw', nw.toFixed(4));
          set('--cd', String(cd));
          set('--cw', String(1 - cd));
          set('--lf', `${fr[0].x.toFixed(1)}px`);
          set('--ng', ng.toFixed(4));
          set('--bx', `${bx.toFixed(1)}px`);
          set('--bo', bo.toFixed(4));
          set('--mo', mo.toFixed(4));
          fr.forEach((f, i) => {
            set(`--in${i}`, `${f.x.toFixed(1)}px`);
            set(`--out${i}`, i + 1 < fr.length ? `${fr[i + 1].x.toFixed(1)}px` : '-3000px');
          });
          // chaque mapping coule : dérive lente, légère rotation ou respiration
          set('--ax', `${(70 * Math.sin(t * 0.9)).toFixed(1)}px`);
          set('--ay', `${(90 * Math.sin(t * 1.1 + 1)).toFixed(1)}px`);
          set('--bxp', `${(-80 * Math.cos(t * 0.8 + 2)).toFixed(1)}px`);
          set('--byp', `${(-70 * Math.sin(t * 1.3 + 4)).toFixed(1)}px`);
          set('--sc', (1 + 0.025 * Math.sin(t * 1.2)).toFixed(4));
          set('--cx', `${(40 * Math.sin(t * 0.7)).toFixed(1)}px`);
          set('--cy', `${(60 * Math.cos(t * 0.6)).toFixed(1)}px`);
          set('--cs', (1.04 + 0.05 * Math.sin(t * 1.5)).toFixed(4));
          set('--cr', `${(2.2 * Math.sin(t * 0.5)).toFixed(2)}deg`);
          set('--dx', `${(50 * Math.cos(t * 0.8)).toFixed(1)}px`);
          set('--dy', `${(40 * Math.sin(t * 0.7)).toFixed(1)}px`);
          set('--ds', (1.03 + 0.03 * Math.sin(t * 1.1)).toFixed(4));
          set('--dr', `${(4 * Math.sin(t * 0.45 + 1)).toFixed(2)}deg`);
          set('--ex', `${(70 * Math.sin(t * 0.8)).toFixed(1)}px`);
          set('--ey', `${(-95 * Math.sin(t * 0.55 + 2)).toFixed(1)}px`);
          set('--es', (1.04 + 0.03 * Math.sin(t * 1.3)).toFixed(4));
          set('--fd', fd.toFixed(4));
        });
        const time = document.querySelector<HTMLElement>('[data-time]');
        const scrub = document.querySelector<HTMLInputElement>('[data-scrub]');
        const sec = Math.floor(t);
        const img = Math.floor((t - sec) * 30);
        if (time) time.textContent = `${sec}:${String(img).padStart(2, '0')}`;
        if (scrub && document.activeElement !== scrub) scrub.value = String(t);
      };

      // ----- mise à l'échelle : la scène fait toujours 1080 x 1920, on la réduit pour l'affichage -----
      const fit = () => {
        const phone = document.querySelector<HTMLElement>('[data-phone]');
        if (phone && !clean) {
          // écran du Galaxy S26 : 9:19,5
          const h = Math.min(Math.max(420, window.innerHeight - 150), 780);
          phone.style.width = `${(h * 9) / 19.5}px`;
        }
        if (!clean) {
          const video = document.querySelector<HTMLElement>('.reel__wrap--video');
          if (video) video.style.width = `${Math.min(window.innerWidth - 40, ((window.innerHeight - 150) * 9) / 16)}px`;
        }
        wraps.forEach((w) => {
          const s = w.querySelector<HTMLElement>('[data-rs]')!;
          if (w.closest('.phone')) {
            // l'écran est plus haut que le 9:16 : la vidéo le remplit (cadrage centré), le logo reste au milieu
            const k = Math.max(w.clientWidth / 1080, w.clientHeight / 1920);
            s.style.transform = `translateX(${(w.clientWidth - 1080 * k) * 0.8}px) scale(${k})`;
          } else {
            const k = clean ? 1 : w.clientWidth / 1080;
            s.style.transform = `scale(${k})`;
            w.style.height = `${1920 * k}px`;
          }
        });
      };

      // ----- lecture -----
      const still = matchMedia('(prefers-reduced-motion: reduce)');
      const loop = document.querySelector<HTMLInputElement>('[data-loop]')!;
      let t0 = 0;
      let playing = false;
      let raf = 0;
      let at = 0;
      // la musique (14 s) suit l'animation : elle démarre et redémarre avec elle, et se tait quand on déplace le curseur
      const audio = document.querySelector<HTMLAudioElement>('[data-audio]')!;
      const soundBtn = document.querySelector<HTMLButtonElement>('[data-sound-toggle]')!;
      let soundOn = false;
      const syncAudio = (from: number) => {
        if (!soundOn || clean) return;
        audio.currentTime = Math.min(from, DURATION - 0.05);
        audio.play().catch(() => undefined);
      };
      const frame = (now: number) => {
        at = (now - t0) / 1000;
        if (at >= DURATION + 1.2) {
          if (loop.checked && !clean) {
            t0 = now;
            at = 0;
            syncAudio(0);
          } else {
            playing = false;
            audio.pause();
            render(DURATION);
            return;
          }
        }
        render(Math.min(at, DURATION));
        raf = requestAnimationFrame(frame);
      };
      const play = (from = 0) => {
        cancelAnimationFrame(raf);
        playing = true;
        t0 = performance.now() - from * 1000;
        audio.pause();
        syncAudio(from);
        raf = requestAnimationFrame(frame);
      };
      const seek = (t: number) => {
        cancelAnimationFrame(raf);
        playing = false;
        audio.pause();
        render(t);
      };
      soundBtn.addEventListener('click', () => {
        soundOn = !soundOn;
        soundBtn.setAttribute('aria-pressed', String(soundOn));
        soundBtn.textContent = soundOn ? 'Son : activé' : 'Son : coupé';
        if (soundOn && playing) syncAudio(Math.min(at, DURATION));
        else audio.pause();
      });

      // ----- vues -----
      const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
      const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-view]')];
      const setView = (v: string) => {
        panels.forEach((p) => (p.hidden = p.dataset.panel !== v));
        tabs.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.view === v)));
        history.replaceState(null, '', `?view=${v}`);
        fit();
        if (!clean) play();
      };
      tabs.forEach((b) => b.addEventListener('click', () => setView(b.dataset.view!)));
      document.querySelector('[data-replay]')!.addEventListener('click', () => play());
      document.querySelector<HTMLInputElement>('[data-scrub]')!.addEventListener('input', (e) => seek(Number((e.target as HTMLInputElement).value)));
      window.addEventListener('resize', fit);

      // ----- démarrage (les images doivent être décodées avant le premier plan, utile pour l'export) -----
      const ready = (async () => {
        await document.fonts?.ready;
        await Promise.all(
          ['--mapa', '--mapb', '--mapc', '--mapd', '--mape'].map((v) => {
            const img = new Image();
            img.src = getComputedStyle(stages[0]).getPropertyValue(v).trim().replace(/^url\(["']?|["']?\)$/g, '');
            return img.decode().catch(() => undefined);
          }),
        );
        measure();
      })();
      (window as unknown as { __reel: unknown }).__reel = { ready, seek, duration: DURATION };

      ready.then(() => {
        const v = params.get('view') === 'mockup' && !clean ? 'mockup' : 'video';
        panels.forEach((p) => (p.hidden = p.dataset.panel !== v));
        tabs.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.view === v)));
        fit();
        const startAt = params.get('t');
        if (startAt !== null) seek(Number(startAt));
        else if (still.matches || clean) seek(clean ? 0 : 5.4);
        else play();
        document.documentElement.dataset.reelReady = '1';
      });
    </script>
  </body>
</html>

<style is:global>
  .reel {
    margin: 0;
    min-height: 100vh;
    background: #05060b;
    color: #f1eee6;
    font-family: var(--font-body, 'Futura', system-ui, sans-serif);
  }

  .reel.is-clean {
    overflow: hidden;
    background: #000;
  }

  .reel.is-clean .reel__bar,
  .reel.is-clean .reel__side {
    display: none;
  }

  .reel.is-clean .reel__main {
    display: block;
    padding: 0;
  }

  .reel.is-clean [data-panel='mockup'] {
    display: none;
  }

  .reel.is-clean .reel__wrap,
  .reel.is-clean .reel__wrap--video {
    width: 1080px !important;
  }

  .reel__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding: 0.8rem clamp(1rem, 3vw, 2rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .reel__back,
  .reel__tools button,
  .reel__tabs button {
    color: inherit;
    font: inherit;
    font-size: 0.85rem;
    text-decoration: none;
  }

  .reel__tabs {
    display: inline-flex;
    padding: 3px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
  }

  .reel__tabs button {
    padding: 0.45rem 1.1rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
  }

  .reel__tabs button[aria-selected='true'] {
    background: #f1eee6;
    color: #05060b;
  }

  .reel__tools {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.85rem;
  }

  .reel__tools button {
    padding: 0.45rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: transparent;
    cursor: pointer;
  }

  .reel a:focus-visible,
  .reel button:focus-visible,
  .reel input:focus-visible {
    outline: 2px solid #ffb44c;
    outline-offset: 3px;
  }

  .reel__main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 24rem);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
    padding: clamp(1rem, 3vw, 2rem);
  }

  .reel__view {
    display: flex;
    justify-content: center;
  }

  .reel__view[hidden] {
    display: none;
  }

  .reel__wrap {
    position: relative;
    overflow: hidden;
    width: 100%;
    background: #000;
  }

  .reel__wrap--video {
    border-radius: 14px;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.14), 0 30px 60px rgba(0, 0, 0, 0.6);
  }

  /* ---- panneau de repères ---- */
  .reel__side {
    font-size: 0.9rem;
    color: rgba(241, 238, 230, 0.8);
  }

  .reel__side h2 {
    margin: 1.4rem 0 0.8rem;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #ffb44c;
  }

  .reel__scrub {
    display: grid;
    gap: 0.5rem;
    font-size: 0.8rem;
  }

  .reel__scrub input {
    width: 100%;
    accent-color: #ffb44c;
  }

  .reel__marks {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .reel__marks li {
    display: grid;
    grid-template-columns: 6.2rem 1fr;
    gap: 0.75rem;
    line-height: 1.45;
  }

  .reel__marks b {
    font-weight: 500;
    color: #f1eee6;
    font-variant-numeric: tabular-nums;
  }

  .reel__note {
    margin-top: 1rem;
    font-size: 0.8rem;
    opacity: 0.7;
  }

  .reel__links {
    display: grid;
    gap: 0.4rem;
    margin-top: 1.2rem;
  }

  .reel__links a {
    color: #f1eee6;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 860px) {
    .reel__main {
      grid-template-columns: 1fr;
    }
  }
</style>
