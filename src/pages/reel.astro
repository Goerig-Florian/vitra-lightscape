---
/**
 * Reel teaser Vitra Lightscape : page interne (présentation de l'appel d'offres), pas un contenu visiteur.
 * Vue 1 : vidéo seule, 9:16. Vue 2 : la même vidéo dans une interface de Reel Instagram du compte @vitra.
 * Paramètres d'adresse : ?view=video|mockup · ?clean (aucune interface, scène 1080 x 1920 : sert à l'export) · &t=secondes.
 */
import '../styles/global.css';
import ReelStage from '../components/ReelStage.astro';
import logoSvg from '../assets/logo/vitra-lightscape.svg?raw';
import { url } from '../lib/url';

// avatar : le « vitra. » original (même fichier), en noir sur rond blanc
const avatar = logoSvg
  .replace('width="346" height="138" viewBox="0 0 346 138"', 'viewBox="4 -3 204 72"')
  .replace('<svg', '<svg aria-hidden="true" focusable="false"')
  .replace('<path ', '<path class="rs-ls" ')
  .replace('<rect ', '<rect class="rs-ls" ');

const timings = [
  { t: '0:00', text: 'Ambiance grave très légère, à peine audible : fond noir, logo Vitra classique fixe.' },
  { t: '1:06 – 2:00', text: 'Le logo classique s’éteint : la nappe grave descend vers le silence presque total.' },
  { t: '2:00 – 2:12', text: 'Écran totalement noir.' },
  { t: '2:12 – 3:03', text: 'Apparition du logo Lightscape : montée subtile, très douce, qui s’ouvre.' },
  { t: '3:03 – 4:21', text: 'Whoosh synchronisé avec le balayage dans les lettres : entrée à gauche à 3:03, pic quand la lumière est au centre du logo (3:24), sortie à droite vers 4:21.' },
  { t: '4:21', text: 'Petit impact doux sur le logo final. La nappe grave retombe.' },
  { t: '5:20 – 6:00', text: 'Queue de réverbération, léger fondu vers le noir.' },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Reel teaser · Vitra Lightscape</title>
    <link rel="icon" href={url('vitra-lightscape-logo.svg')} type="image/svg+xml" />
  </head>
  <body class="reel" data-reel>
    <header class="reel__bar">
      <a class="reel__back" href={url('presentation/')}>← Présentation</a>
      <div class="reel__tabs" role="tablist" aria-label="Vue">
        <button type="button" role="tab" data-view="video" aria-selected="true">Vidéo seule</button>
        <button type="button" role="tab" data-view="mockup" aria-selected="false">Mockup Instagram</button>
      </div>
      <div class="reel__tools">
        <button type="button" data-replay>Rejouer</button>
        <label><input type="checkbox" data-loop checked /> Boucle</label>
      </div>
    </header>

    <main class="reel__main">
      <section class="reel__view" data-panel="video" aria-label="Vidéo seule">
        <div class="reel__wrap reel__wrap--video" data-wrap><ReelStage /></div>
      </section>

      <section class="reel__view" data-panel="mockup" hidden aria-label="Mockup Instagram Reel">
        <div class="phone" data-phone>
          <div class="phone__screen">
            <div class="reel__wrap" data-wrap><ReelStage /></div>

            <div class="ig">
              <div class="ig__status" aria-hidden="true">
                <span>9:41</span>
                <span class="ig__sys">
                  <svg viewBox="0 0 18 12" width="17" height="11"><path d="M1 9h2v2H1zM5 7h2v4H5zM9 4h2v7H9zM13 1h2v10h-2z" fill="currentColor" /></svg>
                  <svg viewBox="0 0 18 12" width="16" height="11"><path d="M9 11 .5 4.2a12 12 0 0 1 17 0Z" fill="currentColor" /></svg>
                  <svg viewBox="0 0 27 12" width="25" height="11"><rect x=".5" y=".5" width="22" height="11" rx="3" fill="none" stroke="currentColor" opacity=".5" /><rect x="2" y="2" width="19" height="8" rx="2" fill="currentColor" /><rect x="24" y="4" width="2" height="4" rx="1" fill="currentColor" opacity=".5" /></svg>
                </span>
              </div>
              <div class="ig__top">
                <span class="ig__title">Reels</span>
                <svg viewBox="0 0 24 24" width="24" height="24" aria-label="Appareil photo"><path d="M4 8.5h3l1.4-2h7.2l1.4 2h3V18H4Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" /><circle cx="12" cy="13" r="3.2" fill="none" stroke="currentColor" stroke-width="1.7" /></svg>
              </div>

              <ul class="ig__side">
                <li>
                  <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M12 20.5s-8-4.8-8-11A4.6 4.6 0 0 1 12 6.8a4.6 4.6 0 0 1 8 2.7c0 6.2-8 11-8 11Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
                  <span>12,8 K</span><span class="sr-only"> mentions J’aime</span>
                </li>
                <li>
                  <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M20.5 11.6c0 4.2-3.8 7.4-8.5 7.4-1 0-1.9-.1-2.8-.4L4.5 20l1.4-3.6A7 7 0 0 1 3.5 11.6C3.5 7.4 7.3 4.2 12 4.2s8.5 3.2 8.5 7.4Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
                  <span>243</span><span class="sr-only"> commentaires</span>
                </li>
                <li>
                  <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M20.5 4 3.5 10.4l6.6 2.5 2.5 6.6Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /><path d="m10.1 12.9 5.4-4.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
                  <span>1 456</span><span class="sr-only"> partages</span>
                </li>
                <li>
                  <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M6.5 3.8h11V20L12 15.6 6.5 20Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
                  <span class="sr-only">Enregistrer</span>
                </li>
                <li>
                  <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><circle cx="5" cy="12" r="1.7" fill="currentColor" /><circle cx="12" cy="12" r="1.7" fill="currentColor" /><circle cx="19" cy="12" r="1.7" fill="currentColor" /></svg>
                  <span class="sr-only">Plus</span>
                </li>
                <li class="ig__disc" aria-hidden="true"><span set:html={avatar}></span></li>
              </ul>

              <div class="ig__bottom">
                <div class="ig__acct">
                  <span class="ig__avatar" aria-hidden="true"><span set:html={avatar}></span></span>
                  <strong>vitra</strong>
                  <svg class="ig__verified" viewBox="0 0 24 24" width="15" height="15" aria-label="Compte vérifié"><path d="M12 1.6l2.6 1.9 3.2-.2 1 3 2.6 1.9-1 3 1 3-2.6 1.9-1 3-3.2-.2L12 22.4l-2.6-1.9-3.2.2-1-3L2.6 15.8l1-3-1-3 2.6-1.9 1-3 3.2.2Z" fill="#3897f0" /><path d="m8.2 12.2 2.7 2.6 5-5.3" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  <button type="button" class="ig__follow" tabindex="-1">Suivre</button>
                </div>
                <p class="ig__cap">Something is coming to the Vitra Campus.<br />Light changes everything.<br /><span>#Vitra #VitraCampus #VitraLightscape</span></p>
                <p class="ig__audio">
                  <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"><path d="M9 18V6.5l9-2V16" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /><circle cx="6.5" cy="18" r="2.5" fill="currentColor" /><circle cx="15.5" cy="16" r="2.5" fill="currentColor" /></svg>
                  vitra · Audio d’origine
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <aside class="reel__side" data-side>
        <label class="reel__scrub">Instant <output data-time>0:00</output>
          <input type="range" min="0" max="6" step="0.01" value="0" data-scrub aria-label="Instant de la vidéo, en secondes" />
        </label>
        <h2>Repères pour le son (Premiere)</h2>
        <ol class="reel__marks">
          {timings.map((m) => <li><b>{m.t}</b><span>{m.text}</span></li>)}
        </ol>
        <p class="reel__note">Les temps sont en secondes : image, à 30 images par seconde (3:03 = 3,1 s). Durée totale 6 s.</p>
        <p class="reel__links">
          <a href={url('reel/vitra-lightscape-teaser-1080x1920.mp4')} download>Vidéo 1080 × 1920 (mp4)</a>
          <a href={url('reel/vitra-lightscape-teaser-720x1280.mp4')} download>Vidéo 720 × 1280 (mp4)</a>
        </p>
      </aside>
    </main>

    <script>
      // ----- chronologie (secondes) -----
      const T = { still: 1.2, off: 2.0, on: 2.4, shown: 3.1, sweepStart: 3.1, sweepEnd: 4.7, fadeStart: 5.65, end: 6 };
      const DURATION = T.end;
      const clamp = (x: number, a = 0, b = 1) => Math.min(b, Math.max(a, x));
      const inOut = (u: number) => (u < 0.5 ? 4 * u * u * u : 1 - Math.pow(-2 * u + 2, 3) / 2);
      const sine = (u: number) => 0.5 - 0.5 * Math.cos(Math.PI * clamp(u));

      const root = document.querySelector<HTMLElement>('[data-reel]')!;
      const params = new URLSearchParams(location.search);
      const clean = params.has('clean');
      root.classList.toggle('is-clean', clean);

      const stages = [...document.querySelectorAll<HTMLElement>('[data-rs]')];
      const wraps = [...document.querySelectorAll<HTMLElement>('[data-wrap]')];

      // centrage : le « vitra. » seul est centré, puis le logo complet glisse au centre pendant la transformation
      const locks = stages.map((s) => s.querySelector<HTMLElement>('[data-rs-lock]')!);
      let glide = { x: 0, y: 0 };
      const measure = () => {
        const svg = locks[0].querySelector('svg')!;
        const els = [...svg.querySelectorAll<SVGGraphicsElement>('path:not(.rs-ls), circle')];
        let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
        els.forEach((el) => {
          const b = el.getBBox();
          x0 = Math.min(x0, b.x); y0 = Math.min(y0, b.y); x1 = Math.max(x1, b.x + b.width); y1 = Math.max(y1, b.y + b.height);
        });
        const k = 640 / 346;
        glide = { x: (173 - (x0 + x1) / 2) * k, y: (69 - (y0 + y1) / 2) * k };
      };

      const render = (t: number) => {
        t = clamp(t, 0, DURATION);
        // 1) le logo classique s'éteint jusqu'au noir total, 2) un instant de noir, 3) le logo Lightscape apparaît
        const ca = 1 - sine((t - T.still) / (T.off - T.still));
        const na = sine((t - T.on) / (T.shown - T.on));
        // 4) la lumière traverse le logo : le mapping n'existe que dans les lettres, dans la zone du balayage
        const u = clamp((t - T.sweepStart) / (T.sweepEnd - T.sweepStart));
        const move = 0.5 - 0.5 * Math.cos(Math.PI * Math.pow(u, 0.92)); // départ et arrivée doux
        const bx = 290 + move * 860; // la zone visible suit le balayage : elle traverse le logo (x 220 à 860) de bout en bout
        const bo = u > 0 && u < 1 ? Math.pow(Math.sin(Math.PI * u), 0.6) : 0;
        const fd = sine((t - T.fadeStart) / (T.end - T.fadeStart)) * 0.9;
        stages.forEach((s) => {
          s.style.setProperty('--ca', ca.toFixed(4));
          s.style.setProperty('--na', na.toFixed(4));
          s.style.setProperty('--gx', `${glide.x.toFixed(2)}px`);
          s.style.setProperty('--gy', `${glide.y.toFixed(2)}px`);
          s.style.setProperty('--bx', `${bx.toFixed(1)}px`);
          s.style.setProperty('--bo', bo.toFixed(4));
          s.style.setProperty('--mx', `${(50 + 38 * Math.sin(t * 1.7)).toFixed(1)}%`);
          s.style.setProperty('--my', `${(50 + 50 * Math.sin(t * 2.3 + 1)).toFixed(1)}%`);
          s.style.setProperty('--fd', fd.toFixed(4));
        });
        const time = document.querySelector<HTMLElement>('[data-time]');
        const scrub = document.querySelector<HTMLInputElement>('[data-scrub]');
        const sec = Math.floor(t);
        const fr = Math.floor((t - sec) * 30);
        if (time) time.textContent = `${sec}:${String(fr).padStart(2, '0')}`;
        if (scrub && document.activeElement !== scrub) scrub.value = String(t);
      };

      // ----- mise à l'échelle : la scène fait toujours 1080 x 1920, on la réduit pour l'affichage -----
      const fit = () => {
        wraps.forEach((w) => {
          const s = w.querySelector<HTMLElement>('[data-rs]')!;
          const k = clean ? 1 : w.clientWidth / 1080;
          s.style.transform = `scale(${k})`;
          w.style.height = `${1920 * k}px`;
        });
        const phone = document.querySelector<HTMLElement>('[data-phone]');
        if (phone && !clean) {
          const avail = Math.max(420, window.innerHeight - 150);
          const h = Math.min(avail, 780);
          phone.style.setProperty('--ph', `${h}px`);
        }
        if (!clean) {
          const video = document.querySelector<HTMLElement>('.reel__wrap--video');
          if (video) video.style.width = `${Math.min(window.innerWidth - 40, ((window.innerHeight - 150) * 9) / 16)}px`;
        }
        wraps.forEach((w) => {
          const s = w.querySelector<HTMLElement>('[data-rs]')!;
          const k = clean ? 1 : w.clientWidth / 1080;
          s.style.transform = `scale(${k})`;
          w.style.height = `${1920 * k}px`;
        });
      };

      // ----- lecture -----
      const still = matchMedia('(prefers-reduced-motion: reduce)');
      const loop = document.querySelector<HTMLInputElement>('[data-loop]')!;
      let t0 = 0;
      let playing = false;
      let raf = 0;
      let at = 0;
      const frame = (now: number) => {
        at = (now - t0) / 1000;
        if (at >= DURATION + 1.2) {
          if (loop.checked && !clean) {
            t0 = now;
            at = 0;
          } else {
            playing = false;
            render(DURATION);
            return;
          }
        }
        render(Math.min(at, DURATION));
        raf = requestAnimationFrame(frame);
      };
      const play = (from = 0) => {
        cancelAnimationFrame(raf);
        playing = true;
        t0 = performance.now() - from * 1000;
        raf = requestAnimationFrame(frame);
      };
      const seek = (t: number) => {
        cancelAnimationFrame(raf);
        playing = false;
        render(t);
      };

      // ----- vues -----
      const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
      const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-view]')];
      const setView = (v: string) => {
        panels.forEach((p) => (p.hidden = p.dataset.panel !== v));
        tabs.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.view === v)));
        history.replaceState(null, '', `?view=${v}`);
        fit();
        if (!clean) play();
      };
      tabs.forEach((b) => b.addEventListener('click', () => setView(b.dataset.view!)));
      document.querySelector('[data-replay]')!.addEventListener('click', () => play());
      document.querySelector<HTMLInputElement>('[data-scrub]')!.addEventListener('input', (e) => seek(Number((e.target as HTMLInputElement).value)));
      window.addEventListener('resize', fit);

      // ----- démarrage (les images doivent être décodées avant le premier plan, utile pour l'export) -----
      const ready = (async () => {
        await document.fonts?.ready;
        const img = new Image();
        img.src = getComputedStyle(stages[0]).getPropertyValue('--map').replace(/^url\(["']?|["']?\)$/g, '');
        await img.decode().catch(() => undefined);
        measure();
      })();
      (window as unknown as { __reel: unknown }).__reel = { ready, seek, duration: DURATION };

      ready.then(() => {
        const v = params.get('view') === 'mockup' && !clean ? 'mockup' : 'video';
        panels.forEach((p) => (p.hidden = p.dataset.panel !== v));
        tabs.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.view === v)));
        fit();
        const startAt = params.get('t');
        if (startAt !== null) seek(Number(startAt));
        else if (still.matches || clean) seek(clean ? 0 : 5.4);
        else play();
        document.documentElement.dataset.reelReady = '1';
      });
    </script>
  </body>
</html>

<style is:global>
  .reel {
    margin: 0;
    min-height: 100vh;
    background: #05060b;
    color: #f1eee6;
    font-family: var(--font-body, 'Futura', system-ui, sans-serif);
  }

  .reel.is-clean {
    overflow: hidden;
    background: #000;
  }

  .reel.is-clean .reel__bar,
  .reel.is-clean .reel__side {
    display: none;
  }

  .reel.is-clean .reel__main {
    display: block;
    padding: 0;
  }

  .reel.is-clean [data-panel='mockup'] {
    display: none;
  }

  .reel.is-clean .reel__wrap,
  .reel.is-clean .reel__wrap--video {
    width: 1080px !important;
  }

  .reel__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding: 0.8rem clamp(1rem, 3vw, 2rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .reel__back,
  .reel__tools button,
  .reel__tabs button {
    color: inherit;
    font: inherit;
    font-size: 0.85rem;
    text-decoration: none;
  }

  .reel__tabs {
    display: inline-flex;
    padding: 3px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
  }

  .reel__tabs button {
    padding: 0.45rem 1.1rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
  }

  .reel__tabs button[aria-selected='true'] {
    background: #f1eee6;
    color: #05060b;
  }

  .reel__tools {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.85rem;
  }

  .reel__tools button {
    padding: 0.45rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: transparent;
    cursor: pointer;
  }

  .reel a:focus-visible,
  .reel button:focus-visible,
  .reel input:focus-visible {
    outline: 2px solid #ffb44c;
    outline-offset: 3px;
  }

  .reel__main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 24rem);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
    padding: clamp(1rem, 3vw, 2rem);
  }

  .reel__view {
    display: flex;
    justify-content: center;
  }

  .reel__view[hidden] {
    display: none;
  }

  .reel__wrap {
    position: relative;
    overflow: hidden;
    width: 100%;
    background: #000;
  }

  .reel__wrap--video {
    border-radius: 14px;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.14), 0 30px 60px rgba(0, 0, 0, 0.6);
  }

  /* ---- téléphone ---- */
  .phone {
    --ph: 720px;
    height: var(--ph);
    aspect-ratio: 9 / 16;
    padding: 9px;
    border-radius: 40px;
    background: #14161c;
    box-shadow: 0 0 0 1.5px #3a3d47, 0 0 0 5px #0a0b0f, 0 40px 80px rgba(0, 0, 0, 0.7);
  }

  .phone__screen {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 32px;
    background: #000;
  }

  .phone .reel__wrap {
    position: absolute;
    inset: 0;
    height: 100% !important;
  }

  /* ---- interface Reels ---- */
  .ig {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: #fff;
    font-size: calc(var(--ph) * 0.0185);
    line-height: 1.3;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.45), transparent 16%),
      linear-gradient(0deg, rgba(0, 0, 0, 0.62), transparent 30%);
  }

  .ig__status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1em 1.9em 0;
    font-weight: 600;
    font-size: 1.05em;
  }

  .ig__sys {
    display: flex;
    align-items: center;
    gap: 0.4em;
  }

  .ig__top {
    position: absolute;
    top: 3.5em;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.4em;
  }

  .ig__title {
    font-size: 1.75em;
    font-weight: 600;
  }

  .ig__side {
    position: absolute;
    right: 0.9em;
    bottom: 8.4em;
    display: grid;
    gap: 1.35em;
    margin: 0;
    padding: 0;
    list-style: none;
    justify-items: center;
    text-align: center;
    font-size: 0.95em;
    font-weight: 600;
  }

  .ig__side li {
    display: grid;
    gap: 0.25em;
    justify-items: center;
  }

  .ig__side svg {
    width: 2.55em;
    height: 2.55em;
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.5));
  }

  .ig__disc {
    width: 2.3em;
    height: 2.3em;
    margin-top: 0.3em;
    border-radius: 0.55em;
    border: 2px solid #fff;
    overflow: hidden;
    background: #fff;
    transform: rotate(8deg);
  }

  .ig__avatar span,
  .ig__disc span {
    display: block;
    width: 100%;
    height: 100%;
    color: #000;
  }

  .ig__avatar svg,
  .ig__disc svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ig__avatar .rs-ls,
  .ig__disc .rs-ls {
    display: none;
  }

  .ig__bottom {
    padding: 0 1.1em 1.6em;
    display: grid;
    gap: 0.75em;
    margin-right: 4.4em;
  }

  .ig__acct {
    display: flex;
    align-items: center;
    gap: 0.6em;
    font-size: 1.12em;
  }

  .ig__avatar {
    display: block;
