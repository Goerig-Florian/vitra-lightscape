---
import Station from './Station.astro';
import { stations } from '../data/stations';
import { stationsIntro } from '../data/content';
---

<section class="stations" id="stations" data-theme="night" aria-labelledby="stations-title">
  <svg class="lightpath" data-lightpath aria-hidden="true" focusable="false">
    <path class="lightpath__base" d="" />
    <path class="lightpath__glow" d="" />
    <path class="lightpath__lit" d="" />
    <circle class="lightpath__head" r="5" cx="-20" cy="-20" />
  </svg>

  <div class="container stations__intro">
    <p class="eyebrow">{stationsIntro.label}</p>
    <h2 class="stations__title reveal" id="stations-title">{stationsIntro.title}</h2>
    <p class="stations__text reveal">{stationsIntro.text}</p>
    <p class="stations__notice">{stationsIntro.notice}</p>
  </div>

  {stations.map((station, index) => <Station station={station} index={index} />)}

  <span class="stations__end" data-path-node aria-hidden="true"></span>
</section>
