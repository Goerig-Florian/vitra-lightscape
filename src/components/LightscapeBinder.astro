---
/**
 * Le livre-classeur : fermé, puis il s'ouvre sur une double page. Trois cartes par page, chacune dans sa pochette
 * transparente avec son texte ; une pochette vide quand la carte n'existe pas encore (31 emplacements, un par bâtiment).
 * Pensé pour les enfants : mots simples, tutoiement. Rendu 100 % CSS / SVG.
 */
import { classeur } from '../data/lightscape-cards';
import Logo from './Logo.astro';
import TitlePage from './LightscapeTitlePage.astro';
import CoverScene from './CoverScene.astro';
import { url } from '../lib/url';

const slots = classeur();
const rangees = slots.filter((s) => s.carte).length;
const flags = slots.map((s) => s.carte);
const PAR_PAGE = 3;
const entrees = Array.from({ length: Math.ceil(slots.length / PAR_PAGE) }, (_, i) => slots.slice(i * PAR_PAGE, (i + 1) * PAR_PAGE));
const total = entrees.length + 1; // + la page de titre
const doubles = Math.ceil(total / 2);
---

<section class="binder" data-theme="night" aria-labelledby="binder-title">
  <div class="container">
    <p class="eyebrow">Le livre de la collection</p>
    <h2 class="binder__title" id="binder-title">Collectionne les {slots.length} cartes du Campus.</h2>
    <p class="binder__lead">Chaque bâtiment a sa carte. Touche une carte pour voir le bâtiment s’allumer. Les pochettes vides attendent les cartes que tu n’as pas encore trouvées.</p>

    <div class="bk" data-binder role="group" aria-roledescription="livre" aria-label="Livre de cartes Lightscape">
      <div class="bk__scene">
        <div class="bk__tilt" data-tilt>
          <div class="bk__book">
            <div class="bk__block" data-sheets>
              <section class="sheet sheet--title" data-sheet data-side="l" aria-label="Page de titre">
                <TitlePage rangees={rangees} total={slots.length} flags={flags} />
              </section>

              {
                entrees.map((page, i) => (
                  <section class="sheet" data-sheet data-side={(i + 1) % 2 ? 'r' : 'l'} hidden aria-label={`Page ${i + 2} sur ${total}`}>
                    <header class="sheet__head">
                      {(i + 1) % 2 ? (
                        <>
                          <span>L’architecture en lumière</span>
                          <span class="sheet__pg">{String(i + 2).padStart(2, '0')} / {String(total).padStart(2, '0')}</span>
                        </>
                      ) : (
                        <>
                          <span class="sheet__logo" aria-hidden="true"><Logo label={false} /></span>
                          <span>Vitra Campus</span>
                        </>
                      )}
                    </header>
                    <ol class="entries">
                      {page.map((s) => (
                        <li class="entry">
                          <div class={`pocket${s.carte ? '' : ' is-empty'}`}>
                            {s.carte ? (
                              <button class="mini" type="button" data-mini aria-pressed="false" aria-label={`${s.name}, carte ${s.n} : voir le bâtiment de nuit`}>
                                <img class="mini__img" src={url(s.jour)} alt="" width="960" height="720" loading="lazy" decoding="async" draggable="false" />
                                <img class="mini__img mini__img--map" src={url(s.mapping)} alt="" width="1448" height="1086" loading="lazy" decoding="async" draggable="false" />
                                <span class="mini__frame" aria-hidden="true"></span>
                                <span class="mini__logo" aria-hidden="true"><Logo label={false} /></span>
                                <span class="mini__no" aria-hidden="true">{s.n} / {slots.length}</span>
                              </button>
                            ) : (
                              <div class="mini mini--empty" aria-hidden="true">
                                <span class="mini__n">{s.n}</span>
                              </div>
                            )}
                          </div>
                          {s.carte ? (
                            <div class="entry__txt">
                              <h4>{s.name}</h4>
                              <p class="entry__by">{[s.author, s.year].filter(Boolean).join(', ')}</p>
                              <p class="entry__text">{s.text}</p>
                            </div>
                          ) : (
                            <div class="entry__txt entry__txt--empty">
                              <h4>Carte n° {s.n}</h4>
                              <p class="entry__text">Pochette vide : cette carte t’attend sur le parcours.</p>
                            </div>
                          )}
                        </li>
                      ))}
                    </ol>
                  </section>
                ))
              }
              <span class="bk__gutter" aria-hidden="true"></span>
            </div>

            <div class="cvr" data-cover>
              <button class="cvr__front" type="button" data-open aria-label="Ouvrir le livre de cartes">
                <span class="cvr__spine" aria-hidden="true"></span>
                <span class="cvr__top">
                  <span class="cvr__logo" aria-hidden="true"><Logo label={false} /></span>
                  <span class="cvr__campus">Vitra Campus</span>
                </span>
                <CoverScene />
                <span class="cvr__bottom">
                  <span class="cvr__title">Album de collection</span>
                  <span class="cvr__rule" aria-hidden="true"></span>
                  <span class="cvr__sub">Architectures en lumière<br />Vitra Campus</span>
                </span>
                <span class="cvr__hint" aria-hidden="true">Ouvrir</span>
              </button>
              <div class="cvr__back" aria-hidden="true">
                <TitlePage rangees={rangees} total={slots.length} flags={flags} />
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="bk__nav">
        <button class="bk__btn" type="button" data-prev aria-label="Pages précédentes">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 12H5M11 6l-6 6 6 6" stroke="currentColor" stroke-width="1.6" fill="none" /></svg>
        </button>
        <p class="bk__count" aria-live="polite"><span data-state hidden>Double page <span data-cur>1</span> / {doubles}</span><span data-closed>Livre fermé</span></p>
        <button class="bk__btn" type="button" data-next aria-label="Pages suivantes">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.6" fill="none" /></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  const bk = document.querySelector<HTMLElement>('[data-binder]');
  if (bk) {
    const sheets = [...bk.querySelectorAll<HTMLElement>('[data-sheet]')];
    const block = bk.querySelector<HTMLElement>('.bk__block')!;
    const cur = bk.querySelector<HTMLElement>('[data-cur]')!;
    const state = bk.querySelector<HTMLElement>('[data-state]')!;
    const closedLabel = bk.querySelector<HTMLElement>('[data-closed]')!;
    const prevBtn = bk.querySelector<HTMLButtonElement>('[data-prev]')!;
    const nextBtn = bk.querySelector<HTMLButtonElement>('[data-next]')!;

    const still = matchMedia('(prefers-reduced-motion: reduce)');
    const narrow = matchMedia('(max-width: 760px)');
    let at = 0; // première page visible
    let turning = false;
    let opened = false;

    // toucher une carte : le bâtiment passe du jour à la nuit (survol et clavier aussi, en CSS)
    bk.querySelectorAll<HTMLButtonElement>('[data-mini]').forEach((m) =>
      m.addEventListener('click', () => {
        const on = m.classList.toggle('is-on');
        m.setAttribute('aria-pressed', String(on));
      }),
    );

    const stepSize = () => (narrow.matches ? 1 : 2);
    const render = () => {
      const step = stepSize();
      sheets.forEach((s, i) => (s.hidden = i < at || i >= at + step));
      cur.textContent = String(Math.floor(at / step) + 1);
      const last = Math.floor((sheets.length - 1) / step) * step;
      nextBtn.disabled = opened && at >= last;
      prevBtn.disabled = !opened || (narrow.matches && at === 0);
      prevBtn.setAttribute('aria-label', at === 0 ? 'Refermer le livre' : 'Pages précédentes');
      state.hidden = !opened;
      closedLabel.hidden = opened;
    };

    // le livre fermé s'ouvre : la couverture pivote autour de la reliure, la double page apparaît
    let doneTimer = 0;
    const open = () => {
      if (opened) return;
      opened = true;
      at = 0;
      bk.classList.add('is-open');
      clearTimeout(doneTimer);
      doneTimer = window.setTimeout(() => bk.classList.add('is-done'), still.matches ? 0 : 1700);
      render();
    };
    // revenir en arrière depuis la première double page : le livre se referme
    const close = () => {
      if (!opened) return;
      opened = false;
      clearTimeout(doneTimer);
      bk.classList.remove('is-done');
      bk.classList.remove('is-open');
      render();
    };
    bk.querySelector('[data-open]')!.addEventListener('click', open);
    new IntersectionObserver(
      (entries, io) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          setTimeout(open, still.matches || narrow.matches ? 0 : 900);
        }
      },
      { threshold: 0.4 },
    ).observe(bk);

    // tourne-page : une feuille se soulève depuis la reliure, et les pages changent à mi-course
    const go = (dir: number) => {
      if (!opened) return dir > 0 ? open() : undefined;
      if (turning) return;
      const step = stepSize();
      if (dir < 0 && at === 0) return narrow.matches ? undefined : close();
      const next = at + dir * step;
      if (next >= sheets.length || next < 0 || next === at) return;
      if (still.matches || narrow.matches) {
        at = next;
        render();
        return;
      }
      turning = true;
      const leaf = document.createElement('span');
      leaf.className = `bk__leaf bk__leaf--${dir > 0 ? 'next' : 'prev'}`;
      leaf.setAttribute('aria-hidden', 'true');
      block.appendChild(leaf);
      const sign = dir > 0 ? -1 : 1;
      const anim = leaf.animate(
        [
          { transform: 'perspective(1800px) rotateY(0deg)', opacity: 0 },
          { transform: `perspective(1800px) rotateY(${sign * 35}deg)`, opacity: 1, offset: 0.18 },
          { transform: `perspective(1800px) rotateY(${sign * 145}deg)`, opacity: 1, offset: 0.82 },
          { transform: `perspective(1800px) rotateY(${sign * 180}deg)`, opacity: 0 },
        ],
        { duration: 1000, easing: 'cubic-bezier(0.45, 0.05, 0.3, 1)' },
      );
      setTimeout(() => {
        at = next;
        render();
      }, 480);
      const done = () => {
        leaf.remove();
        turning = false;
      };
      anim.onfinish = done;
      setTimeout(done, 1150); // garde-fou
    };
    nextBtn.addEventListener('click', () => go(1));
    prevBtn.addEventListener('click', () => go(-1));
    bk.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(1);
      else if (e.key === 'ArrowLeft') go(-1);
    });
    narrow.addEventListener('change', () => {
      at = Math.floor(at / stepSize()) * stepSize();
      render();
    });
    render();
    prevBtn.disabled = true; // le livre démarre fermé : rien avant la couverture

    // perspective et lumière : le livre suit doucement le curseur
    const tiltEl = bk.querySelector<HTMLElement>('[data-tilt]')!;
    let tr = 0;
    bk.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse' || still.matches || narrow.matches || tr) return;
      tr = requestAnimationFrame(() => {
        tr = 0;
        const r = bk.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        tiltEl.style.transform = `rotateX(${(6 - y * 4).toFixed(2)}deg) rotateY(${(x * 5).toFixed(2)}deg)`;
        bk.style.setProperty('--lx', `${((x + 0.5) * 100).toFixed(1)}%`);
        bk.style.setProperty('--ly', `${((y + 0.5) * 100).toFixed(1)}%`);
      });
    });
    bk.addEventListener('pointerleave', () => {
      tiltEl.style.transform = '';
      bk.style.removeProperty('--lx');
      bk.style.removeProperty('--ly');
    });
  }
</script>
