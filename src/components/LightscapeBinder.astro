---
/**
 * Le classeur : un vrai classeur à anneaux, plusieurs cartes par page, chacune dans sa pochette transparente
 * avec une phrase d'explication. Un emplacement par bâtiment (31) : la carte est rangée si elle existe,
 * sinon la pochette reste vide (« à découvrir sur le parcours »). Pensé pour les enfants : mots simples, tutoiement.
 */
import { classeur } from '../data/lightscape-cards';
import Logo from './Logo.astro';
import { url } from '../lib/url';

const slots = classeur();
const rangees = slots.filter((s) => s.carte).length;
const PAR_PAGE = 6;
const pages = Array.from({ length: Math.ceil(slots.length / PAR_PAGE) }, (_, i) => slots.slice(i * PAR_PAGE, (i + 1) * PAR_PAGE));
---

<section class="binder" data-theme="night" aria-labelledby="binder-title">
  <div class="container">
    <p class="eyebrow">Le classeur de la collection</p>
    <h2 class="binder__title" id="binder-title">Collectionne les {slots.length} cartes du Campus.</h2>
    <p class="binder__lead">Chaque bâtiment a sa carte. Touche une carte pour voir le bâtiment s’allumer : le jour, puis la nuit. Les pochettes vides, c’est pour les cartes que tu n’as pas encore trouvées.</p>
    <p class="binder__score"><strong>{rangees}</strong> cartes rangées sur {slots.length}</p>

    <div class="bk" data-binder role="group" aria-roledescription="classeur" aria-label="Classeur de cartes Lightscape">
      <div class="bk__cover">
        <p class="bk__plate"><span>Vitra Campus</span> Classeur Lightscape</p>
        <div class="bk__pages" data-sheets>
          {
            pages.map((page, i) => (
              <section class="sheet" data-sheet data-side={i % 2 ? 'r' : 'l'} hidden={i > 1} aria-label={`Page ${i + 1} sur ${pages.length}`}>
                <ol class="sheet__grid">
                  {page.map((s) => (
                    <li class="slot">
                      <div class={`slot__pocket${s.carte ? '' : ' is-empty'}`}>
                        {s.carte ? (
                          <button class="mini" type="button" data-mini aria-pressed="false" aria-label={`${s.name}, carte ${s.n} : voir le bâtiment de nuit`}>
                            <img class="mini__img" src={url(s.jour)} alt="" width="960" height="720" loading="lazy" decoding="async" draggable="false" />
                            <img class="mini__img mini__img--map" src={url(s.mapping)} alt="" width="1448" height="1086" loading="lazy" decoding="async" draggable="false" />
                            <span class="mini__frame" aria-hidden="true"></span>
                            <span class="mini__logo" aria-hidden="true"><Logo label={false} /></span>
                          </button>
                        ) : (
                          <div class="mini mini--empty" aria-hidden="true">
                            <span class="mini__n">{s.n}</span>
                            <span class="mini__q">?</span>
                          </div>
                        )}
                      </div>
                      {s.carte ? (
                        <p class="slot__cap">
                          <strong><span class="slot__n">{s.n}</span> {s.name}</strong>
                          <span>{s.text}</span>
                        </p>
                      ) : (
                        <p class="slot__cap slot__cap--empty">
                          <strong><span class="slot__n">{s.n}</span> Carte à trouver</strong>
                          <span>Elle t’attend sur le parcours.</span>
                        </p>
                      )}
                    </li>
                  ))}
                </ol>
                <p class="sheet__no" aria-hidden="true">{i + 1}</p>
              </section>
            ))
          }
        </div>
        <span class="bk__rings" aria-hidden="true"><i></i><i></i><i></i></span>
      </div>

      <div class="bk__nav">
        <button class="bk__btn" type="button" data-prev aria-label="Pages précédentes">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 12H5M11 6l-6 6 6 6" stroke="currentColor" stroke-width="1.6" fill="none" /></svg>
        </button>
        <p class="bk__count" aria-live="polite">Pages <span data-from>1</span><span data-to>–2</span> / {pages.length}</p>
        <button class="bk__btn" type="button" data-next aria-label="Pages suivantes">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.6" fill="none" /></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  const bk = document.querySelector<HTMLElement>('[data-binder]');
  if (bk) {
    const sheets = [...bk.querySelectorAll<HTMLElement>('[data-sheet]')];
    const cover = bk.querySelector<HTMLElement>('.bk__cover')!;
    const from = bk.querySelector<HTMLElement>('[data-from]')!;
    const to = bk.querySelector<HTMLElement>('[data-to]')!;
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    const narrow = matchMedia('(max-width: 760px)');
    let at = 0; // première page visible
    let turning = false;

    // toucher une carte : le bâtiment passe du jour à la nuit (survol et clavier aussi, en CSS)
    bk.querySelectorAll<HTMLButtonElement>('[data-mini]').forEach((m) =>
      m.addEventListener('click', () => {
        const on = m.classList.toggle('is-on');
        m.setAttribute('aria-pressed', String(on));
      }),
    );

    const render = () => {
      const step = narrow.matches ? 1 : 2;
      sheets.forEach((s, i) => (s.hidden = i < at || i >= at + step));
      from.textContent = String(at + 1);
      to.textContent = step === 2 && at + 2 <= sheets.length ? `–${at + 2}` : '';
    };
    const stepSize = () => (narrow.matches ? 1 : 2);

    // vrai tourne-page : une feuille se soulève depuis les anneaux, et les pages changent à mi-course
    const go = (dir: number) => {
      const step = stepSize();
      let next = at + dir * step;
      if (next >= sheets.length) next = 0;
      if (next < 0) next = Math.floor((sheets.length - 1) / step) * step;
      if (next === at || turning) return;
      if (still.matches || narrow.matches) {
        at = next;
        render();
        return;
      }
      turning = true;
      const leaf = document.createElement('span');
      leaf.className = `bk__leaf bk__leaf--${dir > 0 ? 'next' : 'prev'}`;
      leaf.setAttribute('aria-hidden', 'true');
      cover.appendChild(leaf);
      const sign = dir > 0 ? -1 : 1;
      const anim = leaf.animate(
        [
          { transform: 'perspective(1800px) rotateY(0deg)', opacity: 0 },
          { transform: `perspective(1800px) rotateY(${sign * 35}deg)`, opacity: 1, offset: 0.18 },
          { transform: `perspective(1800px) rotateY(${sign * 145}deg)`, opacity: 1, offset: 0.82 },
          { transform: `perspective(1800px) rotateY(${sign * 180}deg)`, opacity: 0 },
        ],
        { duration: 1000, easing: 'cubic-bezier(0.45, 0.05, 0.3, 1)' },
      );
      setTimeout(() => {
        at = next;
        render();
      }, 480);
      const done = () => {
        leaf.remove();
        turning = false;
      };
      anim.onfinish = done;
      setTimeout(done, 1150); // garde-fou
    };

    bk.querySelector('[data-next]')!.addEventListener('click', () => go(1));
    bk.querySelector('[data-prev]')!.addEventListener('click', () => go(-1));
    bk.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(1);
      else if (e.key === 'ArrowLeft') go(-1);
    });
    narrow.addEventListener('change', () => {
      at = Math.floor(at / stepSize()) * stepSize();
      render();
    });
    render();

    // à l'arrivée sur la page, le classeur s'ouvre
    new IntersectionObserver(
      (entries, io) => {
        if (entries.some((e) => e.isIntersecting)) {
          bk.classList.add('is-open');
          io.disconnect();
        }
      },
      { threshold: 0.25 },
    ).observe(bk);
  }
</script>
