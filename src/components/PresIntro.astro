---
/**
 * Tout début de la présentation : le logo Deux Rives (l'agence) à côté du logo Vitra, sur un panneau papier clair
 * (le logo Deux Rives est dessiné pour un fond clair : un de ses tracés est brun très sombre).
 * Animation d'entrée : les deux logos glissent l'un vers l'autre, un filet de lumière se trace entre eux, puis un trait de néon fait le tour du panneau.
 * Le « vitra. » est le même SVG que le reste du site (sans la barre ni « Lightscape »).
 */
import deuxRives from '../assets/logo/deux-rives.svg?raw';
import logoSvg from '../assets/logo/vitra-lightscape.svg?raw';

const rives = deuxRives.replace('<svg', '<svg aria-hidden="true" focusable="false"');
const vitra = logoSvg
  .replace('<svg', '<svg aria-hidden="true" focusable="false"')
  .replace('<path ', '<path class="rs-ls" ')
  .replace('<rect ', '<rect class="rs-ls" ');
---

<header class="pi" aria-label="Deux Rives pour Vitra" data-intro>
  <div class="pi__panel">
    <span class="pi__neon" aria-hidden="true"></span>
    <div class="pi__logo pi__logo--rives" set:html={rives} />
    <span class="pi__rule" aria-hidden="true"></span>
    <div class="pi__logo pi__logo--vitra" set:html={vitra} />
  </div>
  <p class="pi__caption"><span class="sr-only">Deux Rives pour </span>Une proposition de communication pour le Vitra Campus</p>
</header>

<script>
  // l'animation démarre quand le panneau apparaît à l'écran (et une seule fois)
  const intro = document.querySelector<HTMLElement>('[data-intro]');
  if (intro) {
    const go = () => intro.classList.add('is-in');
    if (!('IntersectionObserver' in window)) go();
    else {
      const io = new IntersectionObserver((e, o) => {
        if (e.some((x) => x.isIntersecting)) {
          go();
          o.disconnect();
        }
      }, { threshold: 0.3 });
      io.observe(intro);
    }
  }
</script>

<style is:global>
  .pi {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    padding: clamp(5.5rem, 12vw, 8rem) var(--gutter, 1rem) 1rem;
    background: var(--night);
  }

  .pi__panel {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1.25rem, 5vw, 3.5rem);
    width: min(100%, 52rem);
    padding: clamp(1.5rem, 4vw, 2.6rem) clamp(1.5rem, 5vw, 3.5rem);
    border-radius: 18px;
    background: #f5efe6;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
  }

  .pi__logo {
    flex: 1 1 0;
    display: grid;
    align-items: center;
  }

  .pi__logo svg {
    display: block;
    width: 100%;
    height: auto;
    max-height: 9.5rem;
  }

  /* « vitra. » seul, en noir (le panneau est clair) */
  .pi__logo--vitra {
    color: #141414;
  }

  .pi__logo--vitra .rs-ls {
    display: none;
  }

  .pi__logo--rives {
    justify-items: end;
  }

  .pi__logo--vitra {
    justify-items: start;
  }

  .pi__rule {
    flex: none;
    align-self: stretch;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(180deg, transparent, #141414 20%, #141414 80%, transparent);
  }

  /* néon : un filet bleu qui fait le tour du panneau, comme le fil lumineux du site */
  .pi__neon {
    position: absolute;
    inset: -2px;
    z-index: -1;
    border-radius: 20px;
    opacity: 0;
    background: conic-gradient(from var(--pi-a, 0deg), transparent 0 60%, #5aa9ff 80%, #dcefff 88%, transparent 100%);
    filter: blur(0.4px);
  }

  .pi__caption {
    margin: 0;
    max-width: 40rem;
    text-align: center;
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--night-muted);
  }

  /* état initial (avec JavaScript) : tout est caché jusqu'à l'entrée à l'écran */
  .js .pi__logo--rives {
    opacity: 0;
    transform: translateX(-40px);
  }

  .js .pi__logo--vitra {
    opacity: 0;
    transform: translateX(40px);
  }

  .js .pi__rule {
    transform: scaleY(0);
  }

  .js .pi__caption {
    opacity: 0;
  }

  .js .pi.is-in .pi__logo {
    animation: pi-in 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.1s forwards;
  }

  .js .pi.is-in .pi__logo--vitra {
    animation-delay: 0.3s;
  }

  .js .pi.is-in .pi__rule {
    animation: pi-rule 0.9s cubic-bezier(0.5, 0, 0.2, 1) 0.9s forwards;
  }

  .js .pi.is-in .pi__neon {
    animation: pi-neon 2.4s ease-in-out 1.3s 1 forwards;
  }

  .js .pi.is-in .pi__caption {
    animation: pi-fade 0.9s ease 1.8s forwards;
  }

  @keyframes pi-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes pi-rule {
    to {
      transform: scaleY(1);
    }
  }

  @keyframes pi-fade {
    to {
      opacity: 1;
    }
  }

  @property --pi-a {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  @keyframes pi-neon {
    0% {
      --pi-a: 0deg;
      opacity: 0;
    }

    12% {
      opacity: 1;
    }

    88% {
      opacity: 1;
    }

    100% {
      --pi-a: 360deg;
      opacity: 0;
    }
  }

  @media (max-width: 560px) {
    .pi__panel {
      flex-direction: column;
    }

    .pi__logo--rives,
    .pi__logo--vitra {
      justify-items: center;
      width: min(100%, 14rem);
    }

    .pi__rule {
      width: 60%;
      height: 2px;
      align-self: center;
      background: linear-gradient(90deg, transparent, #141414 20%, #141414 80%, transparent);
    }

    .js .pi__rule {
      transform: scaleX(0);
    }

    .js .pi.is-in .pi__rule {
      animation-name: pi-rule-x;
    }
  }

  @keyframes pi-rule-x {
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .js .pi__logo,
    .js .pi__rule,
    .js .pi__caption {
      opacity: 1;
      transform: none;
      animation: none !important;
    }

    .pi__neon {
      display: none;
    }
  }
</style>
