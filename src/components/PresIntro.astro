---
/**
 * Tout début de la présentation : le logo Deux Rives (l'agence), le « vitra. » et le logo Vitra Lightscape du site, séparés par des traits de néon
 * identiques à ceux du site (cœur blanc, lueur bleue). Deux Rives est dessiné pour un fond clair : il repose sur une petite pastille papier.
 * Animation d'entrée : les logos glissent vers le centre, les traits de néon se tracent entre eux.
 * Le « vitra. » est le même SVG que le reste du site (sans la barre ni « Lightscape »).
 */
import deuxRives from '../assets/logo/deux-rives.svg?raw';
import logoSvg from '../assets/logo/vitra-lightscape.svg?raw';

const rives = deuxRives.replace('<svg', '<svg aria-hidden="true" focusable="false"');
const full = logoSvg.replace('<svg', '<svg aria-hidden="true" focusable="false"');
const vitra = logoSvg
  .replace('<svg', '<svg aria-hidden="true" focusable="false"')
  .replace('<path ', '<path class="rs-ls" ')
  .replace('<rect ', '<rect class="rs-ls" ');
---

<header class="pi" aria-label="Deux Rives pour Vitra Lightscape" data-intro>
  <p class="pi__caption"><span class="sr-only">Deux Rives pour </span>Une proposition de communication pour le Vitra Campus</p>
  <div class="pi__panel" data-intro-panel>
    <svg class="pi__frame" aria-hidden="true" focusable="false"><rect class="pi__frame-rect" pathLength="1" x="1.5" y="1.5" rx="16" /></svg>
    <div class="pi__logo pi__logo--rives"><span class="pi__tile" set:html={rives} /></div>
    <div class="pi__logo pi__logo--vitra" set:html={vitra} />
    <div class="pi__logo pi__logo--ls" set:html={full} />
  </div>
</header>

<script>
  // l'animation démarre quand le panneau apparaît à l'écran (et une seule fois)
  const intro = document.querySelector<HTMLElement>('[data-intro]');
  if (intro) {
    const go = () => intro.classList.add('is-in');
    if (!('IntersectionObserver' in window)) go();
    else {
      const io = new IntersectionObserver((e, o) => {
        if (e.some((x) => x.isIntersecting)) {
          go();
          o.disconnect();
        }
      }, { threshold: 0.3 });
      io.observe(intro);
    }
  }
</script>

<style is:global>
  .pi {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    padding: clamp(5.5rem, 12vw, 8rem) var(--gutter, 1rem) 3.5rem;
    background: var(--night);
  }

  .pi__panel {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 3.5vw, 2.5rem);
    width: min(100%, 64rem);
    padding: clamp(1.5rem, 4vw, 2.6rem) clamp(1rem, 4vw, 3rem);
  }

  .pi__logo {
    flex: 1 1 0;
    display: grid;
    align-items: center;
    justify-items: center;
    min-width: 0;
  }

  .pi__logo svg {
    display: block;
    width: 100%;
    height: auto;
    max-height: 8rem;
  }

  .pi__tile {
    display: block;
    width: min(100%, 11rem);
    padding: 0.9rem 1rem;
    border-radius: 14px;
    background: #f5efe6;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  .pi__tile svg {
    max-height: 7rem;
  }

  /* « vitra. » seul, blanc */
  .pi__logo--vitra {
    color: #fff;
  }

  .pi__logo--vitra svg {
    max-width: 10rem;
  }

  .pi__logo--vitra .rs-ls {
    display: none;
  }

  .pi__logo--ls {
    color: #fff;
  }

  .pi__logo--ls svg {
    max-width: 14rem;
  }

  /* cadre néon : cœur blanc, lueur bleue, comme le fil lumineux du site ; il se trace quand les logos apparaissent */
  .pi__frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .pi__frame-rect {
    width: calc(100% - 3px);
    height: calc(100% - 3px);
    fill: none;
    stroke: #f2f8ff;
    stroke-width: 3;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 5px #fff) drop-shadow(0 0 12px #5aa9ff) drop-shadow(0 0 28px rgba(90, 169, 255, 0.75));
  }

  .pi__caption {
    margin: 0;
    max-width: 40rem;
    text-align: center;
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--night-muted);
  }

  .js .pi__logo--rives {
    opacity: 0;
    transform: translateX(-40px);
  }

  .js .pi__logo--vitra {
    opacity: 0;
    transform: translateY(14px);
  }

  .js .pi__logo--ls {
    opacity: 0;
    transform: translateX(40px);
  }

  .js .pi__caption {
    opacity: 0;
  }

  .js .pi__frame-rect {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .js .pi.is-in .pi__frame-rect {
    animation: pi-draw 1.8s cubic-bezier(0.5, 0, 0.2, 1) 0.2s forwards;
  }

  @keyframes pi-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .js .pi.is-in .pi__logo {
    animation: pi-in 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.1s forwards;
  }

  .js .pi.is-in .pi__logo--vitra {
    animation-delay: 0.35s;
  }

  .js .pi.is-in .pi__logo--ls {
    animation-delay: 0.6s;
  }

  .js .pi.is-in .pi__caption {
    animation: pi-fade 0.9s ease 0.1s forwards;
  }

  @keyframes pi-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes pi-fade {
    to {
      opacity: 1;
    }
  }

  @media (max-width: 700px) {
    .pi__panel {
      flex-direction: column;
    }

    .pi__logo {
      width: min(100%, 14rem);
      flex: none;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .js .pi__logo,
    .js .pi__caption {
      opacity: 1;
      transform: none;
      animation: none !important;
    }

    .js .pi__frame-rect {
      stroke-dashoffset: 0;
      animation: none !important;
    }
  }
</style>
