---
/**
 * L'illustration de la couverture du livre : une scène de nuit (bâtiments aux arêtes lumineuses, collines, chemin de lumière).
 * Dessinée en SVG, animée uniquement par CSS (scintillement) ; réutilisée par le livre, le booster et le clip promo.
 */
---

<svg class="cvr__scene" viewBox="0 0 400 300" aria-hidden="true" focusable="false">
  <defs>
    <filter id="cv-glow" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="2.6" result="b" />
      <feMerge><feMergeNode in="b" /><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
    </filter>
    <filter id="cv-soft" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="9" /></filter>
    <radialGradient id="cv-halo" cx="62%" cy="48%" r="55%">
      <stop offset="0" stop-color="#ff9a3c" stop-opacity="0.45" />
      <stop offset="0.55" stop-color="#ff7a1c" stop-opacity="0.12" />
      <stop offset="1" stop-color="#ff7a1c" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="cv-wall" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#1c2f5e" />
      <stop offset="1" stop-color="#0a1432" />
    </linearGradient>
    <linearGradient id="cv-hill" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#14264f" />
      <stop offset="1" stop-color="#070e24" />
    </linearGradient>
    <linearGradient id="cv-ground" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ff9a3c" stop-opacity="0.22" />
      <stop offset="1" stop-color="#ff9a3c" stop-opacity="0" />
    </linearGradient>
    <linearGradient id="cv-path" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#ffb347" stop-opacity="0.9" />
      <stop offset="1" stop-color="#ffe2a8" />
    </linearGradient>
  </defs>

  <ellipse cx="250" cy="130" rx="200" ry="130" fill="url(#cv-halo)" />

  <!-- étoiles -->
  <g class="cv-stars">
    <circle cx="40" cy="40" r="1.6" fill="#ffc46b" />
    <circle cx="92" cy="92" r="1.2" fill="#9fc4ff" />
    <circle cx="130" cy="30" r="1.4" fill="#ffd9a0" />
    <circle cx="196" cy="62" r="1.7" fill="#6aa8ff" />
    <circle cx="300" cy="22" r="1.3" fill="#ffc46b" />
    <circle cx="352" cy="96" r="1.5" fill="#b69cff" />
    <circle cx="372" cy="150" r="1.2" fill="#ffd9a0" />
    <circle cx="28" cy="140" r="1.4" fill="#ffc46b" />
    <circle cx="170" cy="14" r="1.1" fill="#9fc4ff" />
    <circle cx="260" cy="66" r="1.2" fill="#ffd9a0" />
    <circle cx="20" cy="86" r="1.1" fill="#b69cff" />
    <circle cx="330" cy="60" r="1.2" fill="#ffc46b" />
  </g>

  <!-- lune -->
  <path d="M336 60 A 27 27 0 0 1 372 34" fill="none" stroke="#ffcf8a" stroke-width="1.4" opacity="0.8" filter="url(#cv-glow)" />
  <path d="M333 64 A 31 31 0 0 1 376 30" fill="none" stroke="#ffcf8a" stroke-width="0.6" opacity="0.5" />

  <!-- bâtiments : volumes sombres, arêtes lumineuses -->
  <g stroke-linejoin="round">
    <polygon points="150,128 264,26 254,132" fill="url(#cv-wall)" stroke="#ffae4a" stroke-width="1.8" filter="url(#cv-glow)" />
    <polygon points="150,128 254,132 232,150 150,146" fill="#0a1432" stroke="#ffae4a" stroke-width="1" opacity="0.9" />
    <rect x="112" y="98" width="38" height="58" fill="url(#cv-wall)" stroke="#5aa9ff" stroke-width="1.4" filter="url(#cv-glow)" />
    <rect x="60" y="112" width="58" height="44" fill="url(#cv-wall)" stroke="#ffae4a" stroke-width="1.2" filter="url(#cv-glow)" />
    <rect x="68" y="120" width="20" height="28" fill="#ff9a3c" opacity="0.85" />
    <rect x="94" y="126" width="16" height="24" fill="#ffb86a" opacity="0.7" />
    <rect x="228" y="116" width="5" height="54" fill="#ffd28a" filter="url(#cv-glow)" />
    <rect x="238" y="112" width="5" height="58" fill="#ffd28a" filter="url(#cv-glow)" />
    <rect x="245" y="132" width="26" height="36" fill="#ff9a3c" opacity="0.7" />
    <path d="M262 140 L322 104 Q344 94 346 116 L346 152 Q328 164 296 158 L262 152 Z" fill="url(#cv-wall)" stroke="#5aa9ff" stroke-width="1.6" filter="url(#cv-glow)" />
    <path d="M296 158 Q318 150 346 152" fill="none" stroke="#ffae4a" stroke-width="1.2" opacity="0.9" />
    <rect x="170" y="150" width="46" height="22" fill="#0a1432" stroke="#5aa9ff" stroke-width="0.9" opacity="0.9" />
  </g>

  <!-- arbres éclairés -->
  <g fill="none" stroke="#ffb35a" stroke-width="0.9" stroke-linecap="round" opacity="0.9">
    <path d="M44 168 L44 130 M44 150 L30 132 M44 142 L58 124 M44 134 L36 112 M44 128 L52 108 M30 132 L20 126 M58 124 L68 120" />
    <path d="M356 172 L356 138 M356 154 L344 138 M356 148 L368 134 M356 140 L350 122 M356 136 L362 120" />
    <path d="M92 176 L92 156 M92 164 L84 154 M92 160 L100 150" />
  </g>
  <g fill="#ffcf8a" filter="url(#cv-glow)">
    <circle cx="30" cy="132" r="1.7" /><circle cx="58" cy="124" r="1.7" /><circle cx="36" cy="112" r="1.7" /><circle cx="52" cy="108" r="1.7" />
    <circle cx="20" cy="126" r="1.5" /><circle cx="68" cy="120" r="1.5" /><circle cx="44" cy="130" r="1.6" />
    <circle cx="344" cy="138" r="1.6" /><circle cx="368" cy="134" r="1.7" /><circle cx="350" cy="122" r="1.6" /><circle cx="362" cy="120" r="1.6" /><circle cx="356" cy="138" r="1.5" />
    <circle cx="84" cy="154" r="1.4" /><circle cx="100" cy="150" r="1.4" />
  </g>

  <!-- collines -->
  <path d="M0 178 Q60 142 132 168 T256 164 T400 152 L400 300 L0 300 Z" fill="url(#cv-hill)" stroke="#2a4a8f" stroke-width="0.8" />
  <path d="M0 214 Q92 168 200 198 T400 188 L400 300 L0 300 Z" fill="#060c20" stroke="#2a4a8f" stroke-width="0.6" />
  <rect x="0" y="206" width="400" height="94" fill="url(#cv-ground)" />

  <!-- le chemin de lumière -->
  <path class="cv-path" d="M8 246 C86 228 160 232 214 208 S282 190 306 176" fill="none" stroke="url(#cv-path)" stroke-width="3.2" stroke-linecap="round" filter="url(#cv-glow)" />
  <path d="M120 232 C170 226 205 214 226 204" fill="none" stroke="#ffd28a" stroke-width="1" opacity="0.6" />
  <path d="M60 262 C140 252 220 256 300 244" fill="none" stroke="#ffae4a" stroke-width="0.8" opacity="0.28" />
  <path d="M20 280 C120 270 240 274 380 262" fill="none" stroke="#ffae4a" stroke-width="0.6" opacity="0.18" />

  <!-- lucioles -->
  <g class="cv-stars" fill="#ffcf8a" filter="url(#cv-glow)">
    <circle cx="70" cy="204" r="1.8" /><circle cx="150" cy="188" r="1.6" /><circle cx="236" cy="228" r="1.8" /><circle cx="330" cy="206" r="1.6" /><circle cx="286" cy="250" r="1.5" /><circle cx="110" cy="256" r="1.5" />
  </g>
</svg>
