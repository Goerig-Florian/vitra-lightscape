---
/**
 * Fil d'Ariane lumineux : une ligne verticale sur le côté de la page, un point par grand bloc.
 * La ligne descend au fil du défilement et allume les points l'un après l'autre, comme le chemin
 * du parcours. Les points sont des liens (clavier : Tab, Entrée). Masqué sur petit écran.
 */
import { getT } from '../lib/i18n';
const t = getT(Astro.url);
const blocs = t.rail.map(([href, label]) => ({ href, label }));
---

<nav class="rail" data-rail aria-label={t.railAria}>
  <span class="rail__track" aria-hidden="true"><span class="rail__fill"></span></span>
  <ol class="rail__list">
    {
      blocs.map((b) => (
        <li>
          <a class="rail__dot" href={b.href}>
            <span class="rail__label" aria-hidden="true">{b.label}</span>
            <span class="sr-only">{b.label}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>
