---
import { hero, nav } from '../data/content';
---

<header class="site-header" id="top">
  <div class="grid">
    <div class="site-header__bar">
      <p class="site-header__kicker">{hero.kicker}</p>
      <nav class="site-nav" aria-label="Navigation principale" data-nav>
        <button
          class="site-nav__toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav-list"
          data-nav-toggle
        >
          <span class="site-nav__toggle-bar" aria-hidden="true" />
          Menu
        </button>
        <ul class="site-nav__list" id="site-nav-list">
          {
            nav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>
