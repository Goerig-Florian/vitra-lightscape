---
import Logo from './Logo.astro';
import { nav } from '../data/content';
import { url } from '../lib/url';

interface Props {
  home?: boolean;
}
const { home = true } = Astro.props;
const link = (href: string) => (home ? href : url(href));
---

<header class="site-header" data-header data-theme={home ? 'hero' : 'day'}>
  <div class="site-header__inner">
    <a class="site-header__logo" href={home ? '#top' : url()} aria-label="Vitra Lightscape, accueil">
      <Logo label={false} />
    </a>

    <nav class="site-nav" aria-label="Navigation principale" data-nav>
      <button class="icon-btn site-nav__toggle" type="button" aria-expanded="false" aria-controls="site-nav-list" data-nav-toggle>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18" stroke="currentColor" stroke-width="1.6" fill="none" /></svg>
        <span class="sr-only">Menu</span>
      </button>
      <ul class="site-nav__list" id="site-nav-list">
        {
          nav.map((item) => (
            <li>
              <a href={link(item.href)}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <button class="icon-btn cart-btn" type="button" data-cart-open aria-haspopup="dialog">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path d="M5 8h14l-1.2 12H6.2L5 8Z" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round" />
          <path d="M9 8V6.5a3 3 0 0 1 6 0V8" stroke="currentColor" stroke-width="1.5" fill="none" />
        </svg>
        <span class="cart-btn__count" data-cart-count hidden>0</span>
        <span class="sr-only" data-cart-label>Panier</span>
      </button>
      <a class="btn btn--small btn--solid site-header__cta" href={link('#billetterie')}>Réserver</a>
    </div>
  </div>
</header>
