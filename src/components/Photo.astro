---
/**
 * Photographie responsive (AVIF → WebP → JPEG) générée par scripts/optimize-images.py.
 * Les dimensions réelles sont réservées (width/height) pour éviter les sauts de mise en page.
 */
import images from '../data/images.json';
import { url } from '../lib/url';

interface Props {
  id: string;
  alt: string;
  sizes: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  imgClass?: string;
}

const { id, alt, sizes, loading = 'lazy', fetchpriority, class: className, imgClass } = Astro.props;
const meta = (images as Record<string, { width: number; height: number; widths: number[] }>)[id];
if (!meta) throw new Error(`Photo inconnue : ${id} — lancez npm run images`);

const file = (w: number, ext: string) => url(`images/${id}-${w}.${ext}`);
const srcset = (ext: string) => meta.widths.map((w) => `${file(w, ext)} ${w}w`).join(', ');
const fallback = meta.widths.find((w) => w >= 1024) ?? meta.widths[meta.widths.length - 1];
---

<picture class={className ? `photo ${className}` : 'photo'}>
  <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
  <source type="image/webp" srcset={srcset('webp')} sizes={sizes} />
  <img
    class={imgClass}
    src={file(fallback, 'jpg')}
    srcset={srcset('jpg')}
    sizes={sizes}
    width={meta.width}
    height={meta.height}
    alt={alt}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
  />
</picture>
