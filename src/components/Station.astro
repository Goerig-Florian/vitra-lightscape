---
/**
 * Une station : photo de jour, visualisation de nuit et mapping superposés.
 * Au défilement, le script fait passer la station du jour à la nuit (--night)
 * puis dessine le mapping. Les boutons Jour / Nuit / Lumière permettent aussi
 * de choisir l'état (clavier, tactile, animations réduites).
 */
import Photo from './Photo.astro';
import { toPoints, type Station } from '../data/stations';

interface Props {
  station: Station;
  index: number;
}

const { station: s, index } = Astro.props;
const portrait = s.height > s.width;
const sizes = portrait ? '(min-width: 1024px) 34vw, 90vw' : '(min-width: 1024px) 62vw, 100vw';
const clipId = `clip-${s.id}`;
const glowId = `glow-${s.id}`;
const sweepId = `sweep-${s.id}`;
const flip = index % 2 === 1;
---

<article
  class={`station station--${s.kind}${portrait ? ' station--portrait' : ''}${flip ? ' station--flip' : ''}`}
  id={`station-${s.id}`}
  data-station
  style={`--ar: ${s.width} / ${s.height}; --arn: ${(s.width / s.height).toFixed(4)}`}
  aria-labelledby={`station-${s.id}-title`}
>
  <span class="station__node" data-path-node aria-hidden="true"></span>
  <div class="station__sticky">
    <div class="container station__grid">
      <header class="station__head">
        <p class="station__n">Station {s.n}</p>
        <h3 class="station__name" id={`station-${s.id}-title`}>{s.name}</h3>
        <p class="station__meta">{s.author} · {s.year}</p>
      </header>

      <figure class="station__figure">
        <div class="station__frame">
          <Photo id={`${s.image}-jour`} alt={s.alt.day} sizes={sizes} class="station__img station__img--day" />
          <Photo id={`${s.image}-nuit`} alt={s.alt.night} sizes={sizes} class="station__img station__img--night" />

          <svg class="mapping" viewBox={`0 0 ${s.width} ${s.height}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <defs>
              <filter id={glowId} x="-30%" y="-30%" width="160%" height="160%">
                <feGaussianBlur stdDeviation={portrait ? 7 : 9} />
              </filter>
              {
                s.kind === 'sweep' && (
                  <clipPath id={clipId}>
                    <polygon points={toPoints(s.traces[0])} />
                  </clipPath>
                )
              }
              {
                s.kind === 'sweep' && (
                  <linearGradient id={sweepId} x1="0" x2="1" y1="0" y2="0">
                    <stop offset="0" stop-color="#ffd9a0" stop-opacity="0" />
                    <stop offset="0.5" stop-color="#ffe7c2" stop-opacity="0.85" />
                    <stop offset="1" stop-color="#ffd9a0" stop-opacity="0" />
                  </linearGradient>
                )
              }
            </defs>

            {
              s.kind === 'sweep' && (
                <g clip-path={`url(#${clipId})`}>
                  <rect class="mapping__wash" x="0" y="0" width={s.width} height={s.height} />
                  <rect class="mapping__band" data-sweep x="-420" y="0" width="420" height={s.height} fill={`url(#${sweepId})`} />
                </g>
              )
            }

            <g class="mapping__glow" filter={`url(#${glowId})`}>
              {s.traces.map((t) => (s.kind === 'sweep' ? <polygon points={toPoints(t)} pathLength="1" data-draw /> : <polyline points={toPoints(t)} pathLength="1" data-draw />))}
            </g>
            <g class="mapping__core">
              {s.traces.map((t) => (s.kind === 'sweep' ? <polygon points={toPoints(t)} pathLength="1" data-draw /> : <polyline points={toPoints(t)} pathLength="1" data-draw />))}
            </g>
            <g class="mapping__run">
              {s.traces.map((t) => (s.kind === 'sweep' ? <polygon points={toPoints(t)} pathLength="1" /> : <polyline points={toPoints(t)} pathLength="1" />))}
            </g>
            {
              s.nodes && (
                <g class="mapping__nodes">
                  {s.nodes.map(([x, y]) => (
                    <circle cx={x} cy={y} r="7" />
                  ))}
                </g>
              )
            }
          </svg>

          <span class="station__badge">Visualisation</span>
        </div>

        <figcaption class="station__controls">
          <span class="sr-only">Choisir l’état de la vue :</span>
          <div class="phase" role="group" aria-label={`État de la vue, ${s.name}`}>
            <button type="button" class="phase__btn" data-phase="0" aria-pressed="false">Jour</button>
            <button type="button" class="phase__btn" data-phase="0.5" aria-pressed="false">Nuit</button>
            <button type="button" class="phase__btn" data-phase="1" aria-pressed="true">Lumière</button>
            <span class="phase__bar" aria-hidden="true"><span class="phase__fill"></span></span>
          </div>
        </figcaption>
      </figure>

      <div class="station__body">
        <div class="station__block">
          <h4>L’intention</h4>
          <p>{s.intent}</p>
        </div>
        <div class="station__block station__block--light">
          <h4>Ce que la lumière révèle</h4>
          <p>{s.mapping}</p>
        </div>
        <a class="station__source" href={s.source} rel="noopener">
          Fiche du bâtiment sur vitra.com<span class="sr-only"> (site externe)</span>
        </a>
      </div>
    </div>
  </div>
</article>
