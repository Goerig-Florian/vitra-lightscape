---
import Logo from './Logo.astro';
import { url } from '../lib/url';
import { getLang, getT, homeUrl, cartUrl } from '../lib/i18n';

interface Props {
  home?: boolean;
}
const { home = true } = Astro.props;
const lang = getLang(Astro.url);
const t = getT(Astro.url);
const { nav, footer } = t;
const link = (href: string) => (home ? href : homeUrl(lang) + href);
---

<footer class="site-footer" data-theme="night">
  <div class="container">
    <div class="site-footer__top">
      <a href={home ? '#top' : homeUrl(lang)} class="site-footer__logo" aria-label={t.ui.topAria}>
        <Logo label={false} />
      </a>
      <nav aria-label={t.ui.footerNavAria}>
        <ul class="site-footer__nav">
          {nav.map((n) => <li><a href={link(n.href)}>{n.label}</a></li>)}
          <li><a href={cartUrl(lang)}>{t.ui.cart}</a></li>
          {lang === 'fr' && <li><a href={url('devis/devis-2-achats-externes-merchandising.pdf')} target="_blank" rel="noopener">{t.ui.devis2}</a></li>}
          {lang === 'fr' && <li><a href={url('devis/devis-3-production-evenementielle.pdf')} target="_blank" rel="noopener">{t.ui.devis3}</a></li>}
        </ul>
      </nav>
    </div>

    <section class="credits" aria-labelledby="credits-title">
      <h2 id="credits-title">{t.ui.credits}</h2>
      <p>{t.ui.creditsText}</p>
    </section>

    <p class="site-footer__mention">{footer.mention}</p>
  </div>
</footer>
