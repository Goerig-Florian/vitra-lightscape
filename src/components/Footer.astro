---
import Logo from './Logo.astro';
import { nav, footer } from '../data/content';
import { url } from '../lib/url';

interface Props {
  home?: boolean;
}
const { home = true } = Astro.props;
const link = (href: string) => (home ? href : url(href));
---

<footer class="site-footer" data-theme="night">
  <div class="container">
    <div class="site-footer__top">
      <a href={home ? '#top' : url()} class="site-footer__logo" aria-label="Vitra Lightscape, retour en haut">
        <Logo label={false} />
      </a>
      <nav aria-label="Pied de page">
        <ul class="site-footer__nav">
          {nav.map((n) => <li><a href={link(n.href)}>{n.label}</a></li>)}
          <li><a href={url('panier/')}>Panier</a></li>
        </ul>
      </nav>
    </div>

    <section class="credits" aria-labelledby="credits-title">
      <h2 id="credits-title">Crédits</h2>
      <p>
        Vidéo du premier écran : montage réalisé à partir d’une photo de visite de l’équipe (16 septembre 2026) et de sa visualisation de nuit ; le
        coucher de soleil est un étalonnage, la lumière sur le musée une simulation. Liste des bâtiments, auteurs et dates : page « Architecture du
        Vitra Campus » de vitra.com. Plan du parcours : données © contributeurs OpenStreetMap, licence ODbL. Caractère : Inter (SIL Open Font
        License).
      </p>
    </section>

    <p class="site-footer__mention">{footer.mention}</p>
  </div>
</footer>
