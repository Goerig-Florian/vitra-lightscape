---
import Photo from './Photo.astro';
import { hero } from '../data/content';
---

<section class="hero" id="top" data-theme="day" aria-labelledby="hero-title">
  <div class="container hero__head">
    <p class="hero__meta">
      {hero.meta.map((m) => <span>{m}</span>)}
    </p>
    <h1 class="hero__title" id="hero-title">{hero.title}</h1>
    <div class="hero__side">
      <p class="hero__lead">{hero.lead}</p>
      <div class="hero__actions">
        <a class="btn btn--solid" href="#billetterie">{hero.primary}</a>
        <a class="btn btn--line" href="#stations">
          <span class="spark" aria-hidden="true"></span>
          {hero.secondary}
        </a>
      </div>
    </div>
  </div>

  <figure class="hero__media">
    <div class="hero__frame">
      <Photo id="design-museum" alt="Le Vitra Design Museum de Frank Gehry en journée, volumes blancs sous un ciel couvert, reflétés dans un bassin." sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <figcaption class="container caption">{hero.caption}</figcaption>
  </figure>
</section>
