---
/**
 * Premier écran : vidéo de fond du Vitra Design Museum, du jour à la nuit.
 * À la nuit, une vague de lumière douce balaie le musée, découpée sur sa silhouette (calée sur la dernière image).
 * À la fin de la vidéo, la version mapping de cette même dernière image (même cadrage) apparaît en fondu
 * et reste affichée.
 * Animations réduites : pas de lecture automatique, image de nuit fixe.
 */
import { hero } from '../data/content';
import { museeSilhouette } from '../data/batiments';
import { url } from '../lib/url';

const pts = museeSilhouette.map((p) => p.join(',')).join(' ');

---

<section class="hero" id="top" data-theme="hero" data-hero aria-labelledby="hero-title">
  <div class="hero__media">
    <video
      class="hero__video"
      data-hero-video
      muted
      playsinline
      preload="auto"
      poster={url('video/musee-affiche-jour.jpg')}
      data-poster-night={url('video/musee-affiche-nuit.jpg')}
      aria-label={hero.videoLabel}
    >
      <source src={url('video/musee-jour-nuit.webm')} type="video/webm" />
      <source src={url('video/musee-jour-nuit.mp4')} type="video/mp4" />
    </video>

    <svg class="hero__mapping" viewBox="0 0 1672 941" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
      <defs>
        <clipPath id="hero-clip"><polygon points={pts} /></clipPath>
        <linearGradient id="hero-band" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#ffd9a0" stop-opacity="0" />
          <stop offset="0.5" stop-color="#ffe7c2" stop-opacity="0.9" />
          <stop offset="1" stop-color="#ffd9a0" stop-opacity="0" />
        </linearGradient>
      </defs>
      <g clip-path="url(#hero-clip)">
        <rect class="hero__wash" width="1672" height="941" />
        <rect class="hero__band" x="-420" width="420" height="941" fill="url(#hero-band)" />
      </g>
    </svg>
    <img class="hero__teaser" src={url('mapping/fin-video-mapping.webp')} alt="" aria-hidden="true" decoding="async" />
    <div class="hero__scrim" aria-hidden="true"></div>
  </div>

  <div class="container hero__content">
    <p class="hero__meta">
      {
        hero.meta.map((m, i) => (
          <span class={i === hero.meta.length - 1 ? 'hero__when' : undefined}>
            {m}
            {i === hero.meta.length - 1 && (
              <span class="hero__count" data-countdown="2027-09-03T19:00:00+02:00">
                <span class="sr-only" data-count-sr></span>
                <span class="hero__count-grid" aria-hidden="true">
                  <span><b data-c="d">--</b><i>jours</i></span>
                  <span><b data-c="h">--</b><i>heures</i></span>
                  <span><b data-c="m">--</b><i>min</i></span>
                  <span><b data-c="s">--</b><i>sec</i></span>
                </span>
              </span>
            )}
          </span>
        ))
      }
    </p>
    <div class="hero__bottom">
      <h1 class="hero__title" id="hero-title">{hero.title}</h1>
      <div class="hero__side">
        <div class="hero__actions">
          <a class="btn btn--quiet btn--neon" href="#billetterie">{hero.primary}</a>
          <a class="btn btn--ghost btn--neon" href="#parcours"><span class="spark" aria-hidden="true"></span>{hero.secondary}</a>
        </div>
      </div>
    </div>
  </div>

  <p class="hero__teaser-note" aria-hidden="true">{hero.teaserNote}</p>

  <div class="hero__controls">
    <p class="hero__note">Vidéo d’ambiance, simulation</p>
    <button type="button" class="hero__ctrl" data-video-toggle aria-pressed="false">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" class="icon-pause"><path d="M8 5h3v14H8zM13 5h3v14h-3z" fill="currentColor" /></svg>
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" class="icon-play"><path d="M8 5l11 7-11 7z" fill="currentColor" /></svg>
      <span data-video-label>Mettre la vidéo en pause</span>
    </button>
  </div>
</section>

<script>
  // compte à rebours jusqu'à l'ouverture (vendredi 3 septembre 2027, 19h00, heure de Weil am Rhein)
  const cd = document.querySelector<HTMLElement>('[data-countdown]');
  if (cd) {
    const cible = new Date(cd.dataset.countdown!).getTime();
    const val = (k: string) => cd.querySelector<HTMLElement>(`[data-c="${k}"]`)!;
    const sr = cd.querySelector<HTMLElement>('[data-count-sr]')!;
    const calme = matchMedia('(prefers-reduced-motion: reduce)');
    let derniereMinute = -1;
    const maj = () => {
      const reste = Math.max(0, cible - Date.now());
      const j = Math.floor(reste / 86400000);
      const h = Math.floor(reste / 3600000) % 24;
      const m = Math.floor(reste / 60000) % 60;
      const sec = Math.floor(reste / 1000) % 60;
      val('d').textContent = String(j);
      val('h').textContent = String(h).padStart(2, '0');
      val('m').textContent = String(m).padStart(2, '0');
      val('s').textContent = String(sec).padStart(2, '0');
      // lecteur d'écran : une annonce par minute (pas toutes les secondes)
      const minute = Math.floor(reste / 60000);
      if (minute !== derniereMinute) {
        derniereMinute = minute;
        sr.textContent = reste === 0 ? 'Vitra Lightscape est ouvert.' : `Ouverture dans ${j} jours, ${h} heures et ${m} minutes.`;
      }
      cd.classList.toggle('is-over', reste === 0);
    };
    maj();
    // avec « réduire les animations », les secondes ne défilent pas : mise à jour à la minute
    setInterval(maj, calme.matches ? 60000 : 1000);
  }
</script>
