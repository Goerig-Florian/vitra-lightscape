---
/**
 * La scène du teaser : 1080 x 1920 (9:16). Aucune animation CSS : tout est piloté par une horloge
 * (reel.astro) qui écrit des variables (--pw, --ca, --na, --bx, --bo, --mo...) pour qu'on puisse aussi se placer à
 * n'importe quel instant (export image par image, curseur de la page).
 * Logos : le SVG original du projet, tel quel. Le « vitra. » seul est le logo classique ; avec la barre et « Lightscape »
 * c'est le logo Vitra Lightscape (mêmes tracés, mêmes proportions).
 * Mapping : uniquement des formes de lumière (flammes), sans bâtiment, en arrière-plan, animées.
 */
import logoSvg from '../assets/logo/vitra-lightscape.svg?raw';
import { url } from '../lib/url';

interface Props {
  /** Texture de mapping, chemin dans public/ (voir scripts/prepare-reel-mapping.py) */
  mapping?: string;
}
const { mapping = 'reel/mapping-flammes.webp' } = Astro.props;

// sans modifier le fichier source : on repère le texte « Lightscape » (1er tracé) et la barre (rect) par une classe
const svg = logoSvg
  .replace('<svg', '<svg aria-hidden="true" focusable="false"')
  .replace('<path ', '<path class="rs-ls" ')
  .replace('<rect ', '<rect class="rs-ls" ');
---

<div class="rs" data-rs style={`--map:url(${url(mapping)})`}>
  <div class="rs__bg rs__bg--a" aria-hidden="true"></div>
  <div class="rs__bg rs__bg--b" aria-hidden="true"></div>
  <div class="rs__shade" aria-hidden="true"></div>
  <div class="rs__paper" aria-hidden="true"></div>
  <div class="rs__lock rs__lock--classic" data-rs-lock set:html={svg} />
  <div class="rs__lock rs__lock--full" set:html={svg} />
  <div class="rs__halo" aria-hidden="true"></div>
  <div class="rs__flare" aria-hidden="true"></div>
  <div class="rs__fade" aria-hidden="true"></div>
</div>

<style is:global>
  .rs {
    --pw: 1; /* opacité du fond blanc du début */
    --ca: 1; /* opacité du logo classique (noir) */
    --na: 0; /* opacité du logo Lightscape (blanc) */
    --gx: 0px;
    --gy: 0px;
    --bx: -400px; /* position de la lumière qui découvre le mapping (x, en pixels de la scène) */
    --bo: 0; /* intensité de la lumière */
    --mo: 0; /* opacité du mapping d'arrière-plan */
    --ax: 50%;
    --ay: 50%;
    --bxp: 50%;
    --byp: 50%;
    --fd: 0; /* fondu final vers le noir */
    position: relative;
    width: 1080px;
    height: 1920px;
    overflow: hidden;
    background: #000;
    color: #fff;
    transform-origin: 0 0;
    font-size: 0;
  }

  /* mapping d'arrière-plan : deux couches de la même texture qui dérivent en sens contraire, fondues en « écran » */
  .rs__bg {
    position: absolute;
    inset: -8%;
    opacity: calc(var(--mo) * 0.72);
    background: var(--map) no-repeat;
    filter: blur(6px) saturate(1.15) brightness(0.95);
    -webkit-mask-image: linear-gradient(90deg, #000 calc(var(--bx) - 360px), transparent calc(var(--bx) + 40px));
    mask-image: linear-gradient(90deg, #000 calc(var(--bx) - 360px), transparent calc(var(--bx) + 40px));
  }

  .rs__bg--a {
    background-size: auto 150%;
    background-position: var(--ax) var(--ay);
  }

  .rs__bg--b {
    background-size: auto 125%;
    background-position: var(--bxp) var(--byp);
    mix-blend-mode: screen;
    opacity: calc(var(--mo) * 0.4);
    transform: scaleX(-1);
  }

  /* ombre douce derrière le logo pour qu'il reste parfaitement lisible */
  .rs__shade {
    position: absolute;
    inset: 0;
    opacity: var(--na);
    background: radial-gradient(ellipse 62% 17% at 50% 48.5%, rgba(0, 0, 0, 0.72), rgba(0, 0, 0, 0.35) 55%, transparent 100%);
  }

  /* fond blanc du début : il passe au noir, le logo noir disparaît dedans */
  .rs__paper {
    position: absolute;
    inset: 0;
    background: #fff;
    opacity: var(--pw);
  }

  /* le logo : 640 px de large, centré dans la zone de sécurité (centre x 540, y 930) */
  .rs__lock {
    position: absolute;
    left: 220px;
    top: 801px;
    width: 640px;
    height: 255px;
  }

  .rs__lock svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* logo classique : le « vitra. » seul, centré, en noir (même fichier, sans la barre ni « Lightscape ») */
  .rs__lock--classic {
    color: #000;
    opacity: var(--ca);
    transform: translate(var(--gx), var(--gy));
  }

  .rs__lock--classic .rs-ls {
    display: none;
  }

  .rs__lock--full {
    opacity: var(--na);
  }

  /* halo très léger au bord de la lumière qui découvre le mapping */
  .rs__halo {
    position: absolute;
    top: 0;
    left: -280px;
    width: 560px;
    height: 1920px;
    transform: translateX(var(--bx));
    opacity: calc(var(--bo) * 0.6);
    background: radial-gradient(ellipse 50% 46% at 50% 50%, rgba(255, 196, 140, 0.32), rgba(255, 150, 80, 0.08) 45%, transparent 72%);
    mix-blend-mode: screen;
  }

  /* petit flare horizontal à hauteur du logo */
  .rs__flare {
    position: absolute;
    top: 928px;
    left: -380px;
    width: 760px;
    height: 4px;
    transform: translateX(var(--bx));
    opacity: calc(var(--bo) * 0.55);
    background: linear-gradient(90deg, transparent, rgba(255, 232, 205, 0.95) 50%, transparent);
    filter: blur(1.4px);
    mix-blend-mode: screen;
  }

  .rs__fade {
    position: absolute;
    inset: 0;
    background: #000;
    opacity: var(--fd);
  }
</style>
