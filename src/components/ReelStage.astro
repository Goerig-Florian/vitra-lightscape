---
/**
 * La scène du teaser : 1080 x 1920 (9:16), fond noir. Aucune animation CSS : tout est piloté par une horloge
 * (reel.astro) qui écrit des variables (--ca, --na, --bx, --bo, --fd...) pour qu'on puisse aussi se placer à
 * n'importe quel instant (export image par image, curseur de la page).
 * Logos : le SVG original du projet, tel quel. Le « vitra. » seul est le logo classique ; avec la barre et « Lightscape »
 * c'est le logo Vitra Lightscape (mêmes tracés, mêmes proportions).
 * Mapping : uniquement des formes de lumière (flammes), sans bâtiment, découpées DANS les lettres du logo.
 */
import logoSvg from '../assets/logo/vitra-lightscape.svg?raw';
import { url } from '../lib/url';

interface Props {
  /** Texture de mapping, chemin dans public/ (voir scripts/prepare-reel-mapping.py) */
  mapping?: string;
}
const { mapping = 'reel/mapping-flammes.webp' } = Astro.props;

// sans modifier le fichier source : on repère le texte « Lightscape » (1er tracé) et la barre (rect) par une classe
const svg = logoSvg
  .replace('<svg', '<svg aria-hidden="true" focusable="false"')
  .replace('<path ', '<path class="rs-ls" ')
  .replace('<rect ', '<rect class="rs-ls" ');
---

<div class="rs" data-rs style={`--map:url(${url(mapping)});--logo:url(${url('vitra-lightscape-logo.svg')})`}>
  <div class="rs__lock rs__lock--classic" data-rs-lock set:html={svg} />
  <div class="rs__lit" aria-hidden="true"><div class="rs__lock rs__lock--lit" set:html={svg} /></div>
  <div class="rs__lock rs__lock--full" set:html={svg} />
  <div class="rs__fill" aria-hidden="true"></div>
  <div class="rs__halo" aria-hidden="true"></div>
  <div class="rs__flare" aria-hidden="true"></div>
  <div class="rs__fade" aria-hidden="true"></div>
</div>

<style is:global>
  .rs {
    --ca: 1; /* opacité du logo classique */
    --na: 0; /* opacité du logo Lightscape */
    --gx: 0px;
    --gy: 0px;
    --bx: -400px; /* position du balayage (x, en pixels de la scène) */
    --bo: 0; /* intensité du balayage */
    --mx: 50%; /* dérive du mapping dans les lettres */
    --my: 0%;
    --fd: 0; /* fondu final vers le noir */
    position: relative;
    width: 1080px;
    height: 1920px;
    overflow: hidden;
    background: #000;
    color: #fff;
    transform-origin: 0 0;
    font-size: 0;
  }

  /* le logo : 640 px de large, centré dans la zone de sécurité (centre x 540, y 930) */
  .rs__lock {
    position: absolute;
    left: 220px;
    top: 801px;
    width: 640px;
    height: 255px;
  }

  .rs__lock svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* logo classique : le « vitra. » seul, centré (même fichier, sans la barre ni « Lightscape ») */
  .rs__lock--classic {
    opacity: var(--ca);
    transform: translate(var(--gx), var(--gy));
  }

  .rs__lock--classic .rs-ls {
    display: none;
  }

  .rs__lock--full {
    opacity: var(--na);
  }

  /* le mapping est incrusté dans les lettres : la texture est découpée dans la forme du logo, uniquement dans la zone du balayage */
  .rs__fill {
    position: absolute;
    left: 220px;
    top: 801px;
    width: 640px;
    height: 255px;
    opacity: var(--bo);
    background: var(--map) var(--mx) var(--my) / 125% auto no-repeat;
    filter: brightness(1.35) saturate(1.2) contrast(1.05);
    -webkit-mask-image: var(--logo), linear-gradient(90deg, transparent calc(var(--bx) - 370px), #000 calc(var(--bx) - 338px), #000 calc(var(--bx) - 180px), transparent calc(var(--bx) - 20px));
    -webkit-mask-size: 100% 100%, 100% 100%;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-composite: source-in;
    mask-image: var(--logo), linear-gradient(90deg, transparent calc(var(--bx) - 370px), #000 calc(var(--bx) - 338px), #000 calc(var(--bx) - 180px), transparent calc(var(--bx) - 20px));
    mask-size: 100% 100%, 100% 100%;
    mask-repeat: no-repeat;
    mask-composite: intersect;
  }

  /* lueur chaude autour des lettres, là où passe la lumière */
  .rs__lit {
    position: absolute;
    inset: 0;
    opacity: var(--bo);
    -webkit-mask-image: linear-gradient(90deg, transparent calc(var(--bx) - 200px), #000 calc(var(--bx) - 30px), #000 calc(var(--bx) + 30px), transparent calc(var(--bx) + 260px));
    mask-image: linear-gradient(90deg, transparent calc(var(--bx) - 200px), #000 calc(var(--bx) - 30px), #000 calc(var(--bx) + 30px), transparent calc(var(--bx) + 260px));
  }

  .rs__lock--lit {
    filter: drop-shadow(0 0 8px rgba(255, 170, 90, 0.9)) drop-shadow(0 0 30px rgba(255, 120, 40, 0.5));
  }

  /* halo très léger devant le masque */
  .rs__halo {
    position: absolute;
    top: 585px;
    left: -250px;
    width: 500px;
    height: 690px;
    transform: translateX(var(--bx));
    opacity: calc(var(--bo) * 0.7);
    background: radial-gradient(ellipse 50% 46% at 50% 50%, rgba(255, 196, 140, 0.26), rgba(255, 150, 80, 0.08) 45%, transparent 72%);
    mix-blend-mode: screen;
  }

  /* petit flare horizontal à hauteur du logo */
  .rs__flare {
    position: absolute;
    top: 928px;
    left: -380px;
    width: 760px;
    height: 4px;
    transform: translateX(var(--bx));
    opacity: calc(var(--bo) * 0.55);
    background: linear-gradient(90deg, transparent, rgba(255, 232, 205, 0.95) 50%, transparent);
    filter: blur(1.4px);
    mix-blend-mode: screen;
  }

  .rs__fade {
    position: absolute;
    inset: 0;
    background: #000;
    opacity: var(--fd);
  }
</style>
