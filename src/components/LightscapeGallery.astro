---
/**
 * Galerie de cartes Lightscape (page de présentation).
 * Le tilt et la bascule se règlent dans src/data/lightscape-cards.ts (objet `reglages`).
 */
import LightscapeCard from './LightscapeCard.astro';
import { cartes, reglages } from '../data/lightscape-cards';

const liste = cartes();
---

{
  liste.length > 0 && (
    <section class="lgallery" data-theme="night" aria-labelledby="lgallery-title">
      <div class="container">
        <p class="eyebrow">Cartes à gagner</p>
        <h2 class="lgallery__title" id="lgallery-title">Le bâtiment se transforme en Vitra Lightscape.</h2>
        <p class="lgallery__lead">Inclinez la carte : le bâtiment passe du jour à sa version Lightscape. Glissez pour la faire tourner, cliquez pour la retourner.</p>
        <ul class="lgallery__grid" data-lgallery data-tilt={reglages.tilt} data-reveal={reglages.reveal}>
          {liste.map((c) => (
            <li>
              <LightscapeCard carte={c} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<script>
  const grid = document.querySelector<HTMLElement>('[data-lgallery]');
  if (grid) {
    const maxTilt = Number(grid.dataset.tilt ?? 12);
    const soft = Number(grid.dataset.reveal ?? 0.18); // largeur de la zone de bascule, en part de la carte
    const still = matchMedia('(prefers-reduced-motion: reduce)');

    grid.querySelectorAll<HTMLButtonElement>('[data-lcard]').forEach((card) => {
      const tilt = card.querySelector<HTMLElement>('.lcard__tilt')!;
      let px = 0.5; // position visée (0 à 1)
      let py = 0.5;
      let cx = 0.5; // position affichée
      let cy = 0.5;
      let active = false; // la souris est sur la carte
      let pinned = false; // version mapping figée
      let sweep = 0; // bascule jour -> mapping (0 à 1)
      let spin = 0; // rotation autour de l'axe vertical, en degrés (affichée)
      let spinTo = 0; // rotation visée
      let from = 0; // départ du dernier mouvement chronométré
      let t0 = 0;
      let dur = 0; // durée (ms) du mouvement chronométré en cours, 0 si aucun
      let drag: { x: number; base: number } | null = null;
      let moved = false;
      let raf = 0;

      const draw = () => {
        raf = 0;
        const k = still.matches ? 1 : 0.14;
        cx += (px - cx) * k;
        cy += (py - cy) * k;
        let lift = 0;
        if (still.matches) spin = spinTo;
        else if (drag) spin += (spinTo - spin) * 0.35;
        else if (dur) {
          // tour chronométré : démarrage doux, pleine vitesse au milieu, arrêt doux (on voit vraiment la carte tourner)
          const u = Math.min(1, (performance.now() - t0) / dur);
          spin = from + (spinTo - from) * (u < 0.5 ? 4 * u * u * u : 1 - Math.pow(-2 * u + 2, 3) / 2);
          lift = Math.sin(Math.PI * u) * 0.08;
          if (u >= 1) dur = 0;
        } else spin = spinTo;
        // effet lenticulaire : l'image bascule du jour au mapping quand la carte passe d'un côté à l'autre
        const goal = pinned ? 1 : active ? Math.min(1, Math.max(0, (px - 0.5) / soft + 0.5)) : 0;
        sweep += (goal - sweep) * (still.matches ? 1 : 0.2);
        const on = active || pinned || Math.abs(spinTo - spin) > 1;
        card.style.setProperty('--x', `${(cx * 100).toFixed(1)}%`);
        card.style.setProperty('--y', `${(cy * 100).toFixed(1)}%`);
        card.style.setProperty('--m', sweep.toFixed(3));
        card.style.setProperty('--f', (on ? 0.5 + 0.5 * (1 - Math.abs(2 * sweep - 1)) : 0).toFixed(3));
        card.style.setProperty('--shine', on ? '1' : '0');
        card.style.setProperty('--hue', `${Math.round(cx * 240 + cy * 80 + spin)}deg`);
        const hover = active && !drag ? (cx - 0.5) * 2 * maxTilt : 0;
        tilt.style.transform = still.matches
          ? ''
          : `rotateX(${((0.5 - cy) * 2 * maxTilt).toFixed(2)}deg) rotateY(${(hover + spin).toFixed(2)}deg) scale(${((active ? 1.03 : 1) + lift).toFixed(3)})`;
        const moving =
          Math.abs(px - cx) > 0.002 || Math.abs(py - cy) > 0.002 || Math.abs(goal - sweep) > 0.002 || Math.abs(spinTo - spin) > 0.05 || dur > 0;
        if (moving) raf = requestAnimationFrame(draw);
      };
      const go = () => {
        if (!raf) raf = requestAnimationFrame(draw);
      };

      const point = (e: PointerEvent) => {
        const r = card.getBoundingClientRect();
        px = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
        py = Math.min(1, Math.max(0, (e.clientY - r.top) / r.height));
        active = true;
      };

      card.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse') {
          point(e);
          go();
        }
      });
      card.addEventListener('pointerdown', (e) => {
        dur = 0;
        drag = { x: e.clientX, base: spin };
        moved = false;
        point(e);
        go();
      });
      card.addEventListener('pointermove', (e) => {
        if (drag) {
          const dx = e.clientX - drag.x;
          if (!moved && Math.abs(dx) > 6) {
            moved = true;
            card.setPointerCapture(e.pointerId);
          }
          if (moved) spinTo = drag.base + (dx / card.clientWidth) * 420; // un peu plus d'un tour pour une largeur de carte
          point(e);
          go();
        } else if (e.pointerType === 'mouse') {
          point(e);
          go();
        }
      });
      const release = () => {
        if (drag && moved) {
          // la carte se repose sur une face, en finissant son tour
          const to = Math.round(spinTo / 360) * 360;
          from = spin;
          spinTo = to;
          t0 = performance.now();
          dur = 350 + Math.min(700, Math.abs(to - spin) * 3);
        }
        drag = null;
        go();
      };
      card.addEventListener('pointerup', (e) => {
        release();
        if (e.pointerType !== 'mouse') {
          active = false;
          px = 0.5;
          py = 0.5;
          go();
        }
      });
      card.addEventListener('pointercancel', () => {
        release();
        active = false;
        go();
      });
      card.addEventListener('pointerleave', (e) => {
        if (drag) return;
        if (e.pointerType === 'mouse') {
          active = false;
          px = 0.5;
          py = 0.5;
          go();
        }
      });

      // clic, tap ou clavier : la carte fait un tour complet et fige l'autre version
      card.addEventListener('click', () => {
        if (moved) {
          moved = false;
          return;
        }
        pinned = !pinned;
        card.setAttribute('aria-pressed', String(pinned));
        from = spin;
        spinTo = Math.round(spinTo / 360) * 360 + 360;
        t0 = performance.now();
        dur = 1300; // un tour complet, bien lisible
        go();
      });
    });
  }
</script>
