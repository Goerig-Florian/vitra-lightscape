---
/**
 * Fin de la présentation : 1) le site web (lien vers l'accueil), 2) la vidéo « Vitra by Night » (ancre #video, liée depuis le header).
 */
import { url } from '../lib/url';
---

<section class="sl sl--site" data-theme="night" aria-labelledby="sl-site">
  <div class="container sl__inner">
    <p class="eyebrow">Le site web</p>
    <h2 class="sl__title reveal" id="sl-site">Le site pour préparer sa venue.</h2>
    <p class="sl__lead reveal">Le parcours en 31 étapes, les soirées du 3 septembre au 3 octobre 2027, la billetterie et les infos pratiques, au même endroit.</p>
    <p class="reveal"><a class="btn btn--quiet btn--neon" href={url()}>Ouvrir le site <span class="arrow" aria-hidden="true">→</span></a></p>
  </div>
</section>

<section class="sl sl--devis" id="devis" data-theme="night" aria-labelledby="sl-devis">
  <div class="container sl__inner">
    <p class="eyebrow">Devis stratégie de communication</p>
    <h2 class="sl__title reveal" id="sl-devis">Devis 1 · Communication 360°.</h2>
    <p class="sl__lead reveal">Conseil, création, déploiement et pilotage de la campagne Vitra Lightscape.</p>
    <figure class="sl__pdf reveal">
      <button type="button" class="poster" data-poster aria-label="Devis 1, communication 360° : afficher le devis en plein écran">
        <img src={url('presentation/devis-1.webp')} alt="Devis DR-2026-001 de l’agence Deux Rives pour Vitra Lightscape : communication 360°, du conseil au pilotage de campagne, avec le détail des prestations et des montants hors taxes." width="1469" height="1901" loading="lazy" decoding="async" />
        <span class="poster__zoom" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg></span>
      </button>
      <figcaption><strong>Devis 1 · Communication 360°</strong></figcaption>
    </figure>
    <div class="sl__cta reveal">
      <a class="btn btn--light" href={url('devis/devis-2-achats-externes-merchandising.pdf')} target="_blank" rel="noopener">Devis 2 · Achats externes et merchandising</a>
      <a class="btn btn--light" href={url('devis/devis-3-production-evenementielle.pdf')} target="_blank" rel="noopener">Devis 3 · Production événementielle</a>
    </div>
  </div>
</section>

<section class="sl sl--video" id="video" data-theme="night" aria-labelledby="sl-video">
  <div class="container sl__inner">
    <p class="eyebrow">La vidéo</p>
    <h2 class="sl__title reveal" id="sl-video">Vitra by Night.</h2>
    <figure class="sl__film reveal">
      <video class="sl__film-video" controls playsinline preload="metadata" poster={url('reel/vitra-by-night-poster.jpg')} aria-label="Vitra by Night : le Vitra Campus de nuit, ses bâtiments transformés par la lumière">
        <source src={url('reel/vitra-by-night-v2-960p.mp4')} type="video/mp4" />
      </video>
    </figure>
  </div>
</section>

<style is:global>
  .sl__pdf {
    margin: clamp(1.5rem, 4vw, 2.5rem) auto 0;
    max-width: 58rem;
  }

  .sl__pdf .poster {
    width: 100%;
    border-radius: 12px;
    background: #fff;
  }

  .sl__pdf .poster img {
    width: 100%;
    height: auto;
  }

  .sl__pdf figcaption {
    margin-top: 0.9rem;
    text-align: center;
    color: var(--night-muted);
  }

  .sl__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin: clamp(1.5rem, 4vw, 2.5rem) auto 0;
  }

  .sl--devis {
    scroll-margin-top: 4rem;
  }

  .sl__film {
    margin: clamp(1.5rem, 4vw, 2.5rem) 0 0;
  }

  .sl__film-video {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: 82vh;
    margin-inline: auto;
    border-radius: 16px;
    background: #04060f;
    border: 1px solid rgba(220, 239, 255, 0.22);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5), 0 0 24px rgba(90, 169, 255, 0.12);
  }

  .sl--video {
    scroll-margin-top: 4rem;
  }
</style>
