---
/**
 * Le parcours, en « landing » : chiffres clés, carte du Campus (SVG de vitra.com,
 * public/campus-map.svg) et fiche du bâtiment choisi (photo de jour, auteur, année,
 * mode de mise en lumière). À l'entrée dans la section, le chemin lumineux
 * s'allume d'étape en étape et la fiche suit. Un clic (ou Entrée) sur un repère,
 * un élément de la liste ou les flèches de la fiche fixe le choix.
 * La liste des 31 étapes reste disponible, repliée, pour le clavier et la lecture.
 */
import { parcours } from '../data/content';
import { batiments, modes, type Mode } from '../data/batiments';
import { url } from '../lib/url';
import plan from '../data/carte.json';
import fiches from '../data/fiches.json';

// Positions, trajet et formes des bâtiments : scripts/make-map.py. Photos : scripts/fetch-photos.py.
const [vx, vy, vw, vh] = plan.viewBox;
const byId = new Map(plan.stops.map((s) => [s.id, s]));
const stops = batiments.map((b) => {
  const s = byId.get(b.id);
  if (!s) throw new Error(`Étape absente de carte.json : ${b.id} — lancez scripts/make-map.py`);
  const fiche = (fiches as Record<string, { w: number; h: number; href: string }>)[b.id];
  if (!fiche) throw new Error(`Fiche absente de fiches.json : ${b.id} — lancez scripts/fetch-photos.py`);
  return { ...b, ...s, fiche };
});

const order: Mode[] = ['facade', 'interieur', 'interactif'];
const count = (m: Mode) => batiments.filter((b) => b.modes.includes(m)).length;
const num = (i: number) => String(i + 1).padStart(2, '0');
const credit = (b: { author: string; year: string }) => (b.author ? `${b.author}, ${b.year}` : b.year);
const km = (plan.length / 1000).toLocaleString('fr-FR', { maximumFractionDigits: 1 });
const minutes = Math.round(plan.length / (4000 / 60) / 5) * 5; // marche à 4 km/h, arrondie à 5 min
const f = (v: number) => v.toFixed(1);
const photo = (id: string) => url(`photos/${id}.webp`);
const label = (b: (typeof stops)[number], i: number) => `Étape ${i + 1} sur ${stops.length} : ${b.name}, ${credit(b)}`;

// Données de la fiche, lues par main.js
const data = stops.map((b) => ({
  id: b.id,
  name: b.name,
  meta: credit(b),
  photo: photo(b.id),
  w: b.fiche.w,
  h: b.fiche.h,
  href: b.fiche.href,
  modes: b.modes.map((m) => ({ key: m, short: modes[m].short, text: modes[m].text })),
}));
const first = stops[0];

// Light mapping projeté sur 7 bâtiments. Chaque bâtiment reçoit :
//  - un motif (défini dans <defs>), propre à son architecture ;
//  - un faisceau qui le balaie (direction et période en fraction de sa taille : x1, y1, x2, y2) ;
//  - des contours qui pulsent vers l'intérieur et une ligne de lumière qui court le long de sa silhouette.
const mapping: Record<string, { pattern: string; color: string; beam?: [number, number, number, number] }> = {
  vitrahaus: { pattern: 'hatch', color: '#ffe066', beam: [0, 0, 0.7, 0.25] },
  'halle-gehry': { pattern: 'waves', color: '#6fe3ff', beam: [0, 0, 0.6, 0] },
  'halle-grimshaw-1981': { pattern: 'grid', color: '#7af2b8', beam: [0, 0, 0, 0.5] },
  'halle-sanaa': { pattern: 'rings', color: '#b59dff' },
  'halle-grimshaw-1983': { pattern: 'diag', color: '#ff8fd0', beam: [0, 0, 0.45, 0.45] },
  caserne: { pattern: 'chevron', color: '#ff6f6f', beam: [0, 0, 0.5, 0.3] },
  'halle-siza': { pattern: 'vbars', color: '#ff9f43', beam: [0, 0, 0.35, 0] },
};
const mapped = stops.filter((st) => mapping[st.id]);
---

<section class="section parcours" id="parcours" data-theme="night" aria-labelledby="parcours-title" data-parcours>
  <div class="container">
    <div class="parcours__head">
      <div>
        <p class="eyebrow">{parcours.label}</p>
        <h2 class="parcours__title reveal" id="parcours-title">{parcours.title}</h2>
      </div>
      <p class="parcours__text reveal">{parcours.text}</p>
    </div>

    <dl class="kpis reveal">
      <div class="kpis__item">
        <dt>Étapes</dt>
        <dd>{batiments.length}</dd>
        <p>bâtiments et œuvres</p>
      </div>
      <div class="kpis__item">
        <dt>Distance</dt>
        <dd>{km}<span> km</span></dd>
        <p>une boucle à pied</p>
      </div>
      <div class="kpis__item">
        <dt>Marche</dt>
        <dd>≈ {minutes}<span> min</span></dd>
        <p>hors arrêts</p>
      </div>
      <div class="kpis__item">
        <dt>Départ</dt>
        <dd class="kpis__text">Parking visiteurs</dd>
        <p>départ et arrivée</p>
      </div>
    </dl>
    <p class="kpis__note">{parcours.walkNote}</p>

    <div class="filters" role="group" aria-label="Filtrer par mode de mise en lumière">
      <button type="button" class="filter" data-filter="all" aria-pressed="true">Tout <span>{batiments.length}</span></button>
      {
        order.map((m) => (
          <button type="button" class="filter" data-filter={m} aria-pressed="false">
            <span class={`mode-mark mode-mark--${m}`} aria-hidden="true" />
            {modes[m].short} <span>{count(m)}</span>
          </button>
        ))
      }
    </div>

    <div class="parcours__layout">
      <figure class="parcours__map" aria-labelledby="plan-caption">
        <div class="plan__frame" style={`aspect-ratio: ${vw} / ${vh}`}>
          <img
            class="plan__map"
            src={url('campus-map.svg')}
            alt=""
            aria-hidden="true"
            width="549.38"
            height="396.4"
            style={`width: ${(549.38 / vw) * 100}%; left: ${(-vx / vw) * 100}%; top: ${(-vy / vh) * 100}%`}
          />
          <svg
            viewBox={`${vx} ${vy} ${vw} ${vh}`}
            class="plan"
            data-plan
            role="group"
            aria-label={`Carte du Vitra Campus en perspective. Le chemin lumineux part du parking visiteurs et passe par les ${batiments.length} étapes numérotées. Choisissez une étape pour afficher sa fiche.`}
          >
            <defs>
              {
                mapped.map((st) => {
                  const m = mapping[st.id];
                  const c = m.color;
                  const id = `mp-${st.id}`;
                  return (
                    <>
                      {m.pattern === 'hatch' && (
                        <pattern id={id} width="6" height="6" patternUnits="userSpaceOnUse">
                          <path d="M-1 7L7 -1M-1 1L1 -1M5 7L7 5M-1 -1L7 7" stroke={c} stroke-width="0.6" fill="none" />
                          <animateTransform attributeName="patternTransform" type="translate" from="0 0" to="6 0" dur="4s" repeatCount="indefinite" />
                        </pattern>
                      )}
                      {m.pattern === 'waves' && (
                        <pattern id={id} width="14" height="7" patternUnits="userSpaceOnUse">
                          <path d="M0 3.5C3.5 0 7 7 10.5 3.5S14 3.5 14 3.5" stroke={c} stroke-width="0.9" fill="none" />
                          <path d="M-3.5 3.5C0 0 3.5 7 7 3.5" stroke={c} stroke-width="0.5" stroke-opacity="0.6" fill="none" />
                          <animateTransform attributeName="patternTransform" type="translate" from="0 0" to="14 0" dur="3.2s" repeatCount="indefinite" />
                        </pattern>
                      )}
                      {m.pattern === 'grid' && (
                        <pattern id={id} width="5" height="5" patternUnits="userSpaceOnUse">
                          <path d="M0 0H5M0 0V5" stroke={c} stroke-width="0.6" fill="none" />
                          <animateTransform attributeName="patternTransform" type="translate" from="0 0" to="5 5" dur="5s" repeatCount="indefinite" />
                        </pattern>
                      )}
                      {m.pattern === 'diag' && (
                        <pattern id={id} width="6" height="6" patternUnits="userSpaceOnUse">
                          <path d="M-1 7L7 -1M-1 1L1 -1M5 7L7 5" stroke={c} stroke-width="1" fill="none" />
                          <animateTransform attributeName="patternTransform" type="translate" from="0 0" to="6 0" dur="2.4s" repeatCount="indefinite" />
                        </pattern>
                      )}
                      {m.pattern === 'vbars' && (
                        <pattern id={id} width="4" height="4" patternUnits="userSpaceOnUse">
                          <path d="M1 0V4" stroke={c} stroke-width="1.3" fill="none" />
                          <animateTransform attributeName="patternTransform" type="translate" from="0 0" to="4 0" dur="2s" repeatCount="indefinite" />
                        </pattern>
                      )}
                      {m.pattern === 'chevron' && (
                        <pattern id={id} width="8" height="6" patternUnits="userSpaceOnUse">
                          <path d="M0 6L4 1L8 6" stroke={c} stroke-width="0.9" fill="none" />
                          <animateTransform attributeName="patternTransform" type="translate" from="0 0" to="0 -6" dur="2.2s" repeatCount="indefinite" />
                        </pattern>
                      )}
                      {m.pattern === 'rings' && (
                        <radialGradient id={id} gradientUnits="userSpaceOnUse" cx={st.x} cy={st.y} r="9" spreadMethod="repeat">
                          <stop offset="0" stop-color={c} stop-opacity="0" />
                          <stop offset="0.5" stop-color={c} stop-opacity="0.95" />
                          <stop offset="1" stop-color={c} stop-opacity="0" />
                          <animate attributeName="r" values="9;18" dur="3s" repeatCount="indefinite" />
                        </radialGradient>
                      )}
                      <clipPath id={`cp-${st.id}`}>
                        {st.shapes.map((d) => <path d={d} />)}
                      </clipPath>
                      {m.beam && (
                        <linearGradient id={`bm-${st.id}`} x1={m.beam[0]} y1={m.beam[1]} x2={m.beam[2]} y2={m.beam[3]} spreadMethod="repeat">
                          <stop offset="0" stop-color={c} stop-opacity="0" />
                          <stop offset="0.42" stop-color={c} stop-opacity="0" />
                          <stop offset="0.5" stop-color="#ffffff" stop-opacity="0.8" />
                          <stop offset="0.58" stop-color={c} stop-opacity="0" />
                          <stop offset="1" stop-color={c} stop-opacity="0" />
                          <animateTransform attributeName="gradientTransform" type="translate" from="0 0" to={`${m.beam[2] - m.beam[0]} ${m.beam[3] - m.beam[1]}`} dur="3.6s" repeatCount="indefinite" />
                        </linearGradient>
                      )}
                    </>
                  );
                })
              }
            </defs>


            <g class="plan__bldgs" aria-hidden="true">
              {stops.map((s) => s.shapes.map((d) => <path class={mapping[s.id] ? 'plan__bldg is-mapped' : 'plan__bldg'} d={d} style={mapping[s.id] ? `--mc: ${mapping[s.id].color}` : undefined} data-bldg={s.id} />))}
            </g>

            <g class="plan__mappings" aria-hidden="true">
              {
                mapped.map((st) => {
                  const m = mapping[st.id];
                  return st.shapes.map((d) => (
                    <>
                      <path class="plan__mapping" d={d} style={`fill: url(#mp-${st.id})`} data-bldg={st.id} />
                      {m.beam && <path class="plan__mapping plan__mapping--beam" d={d} style={`fill: url(#bm-${st.id})`} data-bldg={st.id} />}
                      <path class="plan__mapping plan__mapping--ring r1" d={d} clip-path={`url(#cp-${st.id})`} style={`--mc: ${m.color}`} data-bldg={st.id} />
                      <path class="plan__mapping plan__mapping--ring r3" d={d} clip-path={`url(#cp-${st.id})`} style={`--mc: ${m.color}`} data-bldg={st.id} />
                      <path class="plan__mapping plan__mapping--edge" d={d} style={`--mc: ${m.color}`} data-bldg={st.id} />
                    </>
                  ));
                })
              }
            </g>

            <g class="plan__route" aria-hidden="true">
              <path class="plan__path-base" d={plan.route} />
              <path class="plan__path-glow" d={plan.route} pathLength="1" data-path />
              <path class="plan__path-lit" d={plan.route} pathLength="1" data-path />
              {
                stops.map((s) =>
                  Math.hypot(s.x - s.ax, s.y - s.ay) > 8 ? (
                    <line class="plan__spur" x1={f(s.ax)} y1={f(s.ay)} x2={f(s.x)} y2={f(s.y)} data-spur={s.id} />
                  ) : null,
                )
              }
            </g>

            <g class="plan__marks" aria-hidden="true">
              <g class="plan__park">
                <rect x={f(plan.parking.x - 9)} y={f(plan.parking.y - 9)} width="18" height="18" rx="3" />
                <text x={f(plan.parking.x)} y={f(plan.parking.y + 4.5)} text-anchor="middle">P</text>
                <text class="plan__tag" x={f(plan.parking.x)} y={f(plan.parking.y + 22)} text-anchor="middle">Parking visiteurs</text>
              </g>
              <g class="plan__gate">
                <circle cx={f(plan.parking.gx)} cy={f(plan.parking.gy)} r="4" />
                <text class="plan__tag" x={f(plan.parking.x)} y={f(plan.parking.y + 34)} text-anchor="middle">Départ · arrivée</text>
              </g>
              <g class="plan__entree">
                <path d={`M ${f(plan.entree.x)} ${f(plan.entree.y - 6)} l 6 6 l -6 6 l -6 -6 z`} />
                <text class="plan__tag" x={f(plan.entree.x - 9)} y={f(plan.entree.y + 15)} text-anchor="end">Entrée</text>
              </g>
            </g>

            <g class="plan__stops">
              {
                stops.map((s, i) => (
                  <g
                    class={`stop ${s.modes.map((m) => 'is-' + m).join(' ')}${s.approx ? ' is-approx' : ''}`}
                    data-stop={String(i)}
                    data-id={s.id}
                    data-at={String(s.at)}
                    style={`--i: ${i}`}
                    role="button"
                    tabindex="0"
                    aria-label={label(s, i)}
                  >
                    <circle class="stop__hit" cx={f(s.x)} cy={f(s.y)} r="14" />
                    <circle class="stop__halo" cx={f(s.x)} cy={f(s.y)} r="13" />
                    <circle class="stop__dot" cx={f(s.x)} cy={f(s.y)} r="7.5" />
                    <text class="stop__n" x={f(s.x)} y={f(s.y + 2.6)} text-anchor="middle" aria-hidden="true">{i + 1}</text>
                  </g>
                ))
              }
            </g>
          </svg>
        </div>

        <div class="plan__bar">
          <p class="plan__now" data-plan-now>
            <span class="plan__now-n" data-now-n>{num(0)}</span>
            <span class="plan__now-text">
              <strong data-now-name>{first.name}</strong>
              <span data-now-meta>{credit(first)}</span>
            </span>
          </p>
          <button type="button" class="plan__ctrl" data-plan-toggle hidden>
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" class="icon-pause"><path d="M8 5h3v14H8zM13 5h3v14h-3z" fill="currentColor" /></svg>
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" class="icon-play"><path d="M8 5l11 7-11 7z" fill="currentColor" /></svg>
            <span data-plan-label>Mettre en pause</span>
          </button>
        </div>

      </figure>

      <article class="fiche" data-fiche aria-label="Fiche du bâtiment">
        <figure class="fiche__photo">
          <img
            data-fiche-img
            src={photo(first.id)}
            width={first.fiche.w}
            height={first.fiche.h}
            alt={`Photographie de jour : ${first.name}`}
            decoding="async"
          />
          <figcaption>{parcours.photoCredit}</figcaption>
          <div class="fiche__nav">
            <button type="button" class="fiche__btn" data-fiche-prev aria-label="Étape précédente">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" fill="none" /></svg>
            </button>
            <button type="button" class="fiche__btn" data-fiche-next aria-label="Étape suivante">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" fill="none" /></svg>
            </button>
          </div>
        </figure>
        <div class="fiche__body" aria-live="polite">
          <p class="fiche__n"><span data-fiche-n>{num(0)}</span> / {batiments.length}</p>
          <h3 class="fiche__name" data-fiche-name>{first.name}</h3>
          <p class="fiche__meta" data-fiche-meta>{credit(first)}</p>
          <div class="fiche__modes" data-fiche-modes>
            {
              first.modes.map((m) => (
                <div class="fiche__mode">
                  <p class={`tag tag--${m}`}>
                    <span class={`mode-mark mode-mark--${m}`} aria-hidden="true" />
                    {modes[m].short}
                  </p>
                  <p>{modes[m].text}</p>
                </div>
              ))
            }
          </div>
          <a class="fiche__link" data-fiche-link href={first.fiche.href} rel="noopener">Voir sur vitra.com<span class="sr-only"> (site externe)</span></a>
        </div>
      </article>
    </div>

    <div class="parcours__notes">
    <ul class="plan__legend" aria-label="Légende de la carte">
      <li><span class="legend__path" aria-hidden="true"></span>Chemin lumineux</li>
      <li><span class="legend__mapping" aria-hidden="true"></span>Light mapping</li>
      <li><span class="mode-mark mode-mark--facade" aria-hidden="true"></span>Façade</li>
      <li><span class="mode-mark mode-mark--interieur" aria-hidden="true"></span>Intérieur</li>
      <li><span class="mode-mark mode-mark--interactif" aria-hidden="true"></span>Interactif</li>
      <li><span class="legend__approx" aria-hidden="true"></span>Repère décalé</li>
    </ul>

    <p class="caption" id="plan-caption">
      {parcours.notice}
      <a href={parcours.carte.href} rel="noopener">{parcours.carte.label}<span class="sr-only"> (site externe)</span></a>. Trajet calculé
      d’après <a href={parcours.osm.href} rel="noopener">{parcours.osm.label}<span class="sr-only"> (site externe)</span></a>, licence ODbL.
    </p>
    </div>

    <details class="steps">
      <summary>Liste des {batiments.length} étapes, dans l’ordre de la visite</summary>
      <ol class="index" data-index>
        {
          stops.map((b, i) => (
            <li class="index__item" data-item={String(i)} data-modes={b.modes.join(' ')}>
              <button type="button" class="index__btn" data-item-btn={String(i)}>
                <span class="index__n">{num(i)}</span>
                <span class="index__main">
                  <span class="index__name">{b.name}</span>
                  <span class="index__meta">
                    {credit(b)}
                    {b.approx && <span class="index__approx"> · repère décalé</span>}
                  </span>
                </span>
                <span class="index__modes">
                  {b.modes.map((m) => (
                    <span class={`tag tag--${m}`}>
                      <span class={`mode-mark mode-mark--${m}`} aria-hidden="true" />
                      {modes[m].short}
                    </span>
                  ))}
                </span>
              </button>
            </li>
          ))
        }
      </ol>
    </details>

    <script type="application/json" id="fiches-data" set:html={JSON.stringify(data)} />

    <p class="parcours__source">
      <a href={parcours.source.href} rel="noopener">{parcours.source.label}<span class="sr-only"> (site externe)</span></a>
    </p>
  </div>
</section>
