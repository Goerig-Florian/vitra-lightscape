---
import { stops } from '../data/stations';
import { parcours } from '../data/content';

// Courbe lissée passant par tous les arrêts (entrée à gauche, sortie à droite)
const pts = [{ x: 20, y: 470 }, ...stops.map((s) => ({ x: s.x, y: s.y })), { x: 1180, y: 250 }];
let d = `M ${pts[0].x} ${pts[0].y}`;
for (let i = 1; i < pts.length; i++) {
  const p0 = pts[i - 1];
  const p1 = pts[i];
  const mx = (p0.x + p1.x) / 2;
  d += ` C ${mx} ${p0.y}, ${mx} ${p1.y}, ${p1.x} ${p1.y}`;
}
---

<section class="section parcours" id="parcours" data-theme="night" aria-labelledby="parcours-title">
  <div class="container">
    <div class="parcours__head">
      <div>
        <p class="eyebrow">{parcours.label}</p>
        <h2 class="parcours__title reveal" id="parcours-title">{parcours.title}</h2>
      </div>
      <p class="parcours__text reveal">{parcours.text}</p>
    </div>

    <figure class="parcours__map">
      <svg viewBox="0 0 1200 520" class="map" data-map aria-hidden="true" focusable="false">
        <defs>
          <filter id="map-glow" x="-10%" y="-40%" width="120%" height="180%">
            <feGaussianBlur stdDeviation="6" />
          </filter>
          <pattern id="map-grid" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M40 0H0V40" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="1" />
          </pattern>
        </defs>
        <rect width="1200" height="520" fill="url(#map-grid)" />
        <path class="map__base" d={d} />
        <path class="map__glow" d={d} filter="url(#map-glow)" pathLength="1" />
        <path class="map__lit" d={d} pathLength="1" />
        <path class="map__flow" d={d} />
        <text class="map__end" x="20" y="500">Entrée</text>
        <text class="map__end" x="1180" y="230" text-anchor="end">Sortie</text>
        {
          stops.map((s, i) => (
            <g class="map__stop" style={`--i: ${i}`}>
              <circle class="map__halo" cx={s.x} cy={s.y} r="26" />
              <circle class="map__dot" cx={s.x} cy={s.y} r="15" />
              <text class="map__n" x={s.x} y={s.y + 5} text-anchor="middle">{s.n}</text>
              <text class="map__label" x={s.x} y={s.y + (s.y > 300 ? 52 : -36)} text-anchor="middle">{s.name}</text>
            </g>
          ))
        }
      </svg>
      <figcaption class="caption">{parcours.notice}</figcaption>
    </figure>

    <ol class="parcours__list">
      {
        stops.map((s) => (
          <li>
            <span class="parcours__n">{s.n}</span>
            <span class="parcours__name">{s.name}</span>
            <span class="parcours__author">{s.author}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>
