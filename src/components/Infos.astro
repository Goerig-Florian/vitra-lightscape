---
import SectionLabel from './SectionLabel.astro';
import { infos } from '../data/content';
---

<section class="section section--light infos" id="infos" aria-labelledby="infos-title">
  <div class="grid infos__grid">
    <SectionLabel n="IV" text={infos.label} />

    <div class="infos__intro">
      <h2 class="infos__status" id="infos-title">
        <span class="infos__dot" aria-hidden="true" />
        {infos.status}
      </h2>
      <p class="infos__note">{infos.statusNote}</p>
    </div>

    <div class="infos__details">
      <dl class="infos__list">
        {
          infos.rows.map((row) => (
            <div class={row.pending ? 'infos__row is-pending' : 'infos__row'}>
              <dt>{row.term}</dt>
              <dd>{row.value}</dd>
            </div>
          ))
        }
      </dl>
      <p class="infos__visit">
        {infos.visit.text}
        <br />
        <a class="link-arrow" href={infos.visit.href} rel="noopener">
          {infos.visit.label}
          <span aria-hidden="true">→</span>
          <span class="sr-only"> (site externe)</span>
        </a>
      </p>
    </div>
  </div>
</section>
