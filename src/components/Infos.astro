---
import { infos } from '../data/content';
---

<section class="section infos" id="infos" data-theme="night" aria-labelledby="infos-title">
  <div class="container">
    <h2 class="eyebrow" id="infos-title">{infos.label}</h2>
    <dl class="infos__grid">
      {
        infos.rows.map((r) => (
          <div class="infos__item">
            <dt>{r.term}</dt>
            <dd>{r.value.split('\n').map((line, i) => (i === 0 ? line : [<br />, line]))}</dd>
          </div>
        ))
      }
    </dl>
    <a class="link-arrow" href={infos.visit.href} rel="noopener">
      {infos.visit.label} <svg class="arrow" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.6" fill="none" /></svg><span class="sr-only"> (site externe)</span>
    </a>
  </div>
</section>
