---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import { dates, slots, tickets, maxPerType } from '../data/billetterie';
import { url } from '../lib/url';

interface Props {
  title: string;
  description: string;
  home?: boolean;
}

const { title, description, home = true } = Astro.props;

// Données de billetterie transmises au script du panier
const label = (iso: string) =>
  new Date(`${iso}T12:00:00`).toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
const booking = JSON.stringify({
  dates: dates.map((d) => ({ id: d, label: label(d) })),
  slots,
  tickets,
  max: maxPerType,
  cartUrl: url('panier/'),
});
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={url('images/vitrahaus-nuit-1672.jpg')} />
    <link rel="icon" href={url('vitra-lightscape-logo.svg')} type="image/svg+xml" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body data-booking={booking}>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header home={home} />
    <main id="contenu">
      <slot />
    </main>
    <Footer home={home} />
    <CartDrawer />
    <div class="toast" data-toast role="status" aria-live="polite" hidden></div>
    <script>
      import '../scripts/main.js';
      import '../scripts/cart.js';
    </script>
  </body>
</html>
